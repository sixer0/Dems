# DEMS Core - environment of the `core` and `tools` services (task 4 row DK). PLACEHOLDERS ONLY.
# Copy to .env beside compose.yaml (git ignores .env) and edit there. NO password, key or credential belongs in
# this file: the database passwords are the three files of ./secrets (README "First start"), the signing key is made
# by `evidence:production-key` at the first production boot, operator passwords by `operator:set-password`.
# Keys and their rules: apps/core-server/src/config.ts and README.md (block "Task 4", "Configuration keys").

# The image compose runs (built by build-image.sh, loaded from the archive with `docker load`).
DEMS_IMAGE=dems/core:task4-6d6553e3-unverified

# Listen port of the Core on 127.0.0.1: 4420 (database dems_demo) or a lane port 4421-4423. Fixed host, not settable.
DEMS_CORE_PORT=4420
# Port of the database server on 127.0.0.1 (compose.yaml starts PostgreSQL on 4432). Never 5432.
DEMS_PG_PORT=4432
DEMS_LOG_LEVEL=info
# 1 turns the demo controls on (never in production: HOST-34).
DEMS_DEMO_CONTROLS=0

# --- Capture operation --------------------------------------------------------------------------------------
# simulated (default): no worker is ever started. real: sessions record through the capture worker.
DEMS_CAPTURE_MODE=simulated
# 1 = development sources (generated test camera and microphone). Never on a production installation (HOST-34).
# NOTE: the generated test camera needs an FFmpeg with libx264 (README Known limit 13); the FFmpeg of this image has
# no external encoder, so development sources cannot run inside this image.
DEMS_CAPTURE_DEV_SOURCES=0
# The programs of real capture, at their paths inside the image (absolute paths; root-owned, HOST-05, HOST-15, HOST-16).
# Leave them commented out in simulated operation.
# DEMS_CAPTURE_WORKER=/opt/dems/core/apps/capture-worker/build/capture-worker
# DEMS_CAPTURE_RELAY=/opt/dems/core/apps/capture-worker/build/capture-relay
# DEMS_CAPTURE_GUARD=/opt/dems/core/apps/capture-worker/build/capture-guard
# DEMS_CAPTURE_AUDIO_HELPER=/opt/dems/ffmpeg-9.0.2/bin/ffmpeg
# Media root; unset = <data directory>/media/sessions = /opt/dems/core/.data/media/sessions (the dems-data volume).
# DEMS_MEDIA_DIR=
# The address helper's socket. The helper is a ROOT SERVICE OF THE HOST (scripts/host/netalias/), never in this image;
# set ONLY on a host that carries all of it, and then exactly to the path its socket unit installs (HOST-34).
# DEMS_CAPTURE_ALIAS_SOCKET=/run/dems-core-netalias/socket

# --- Installation identity ---------------------------------------------------------------------------------
# A capital letter, then capitals, digits or hyphens, at most 32 characters. NEVER DEMS-TEST-01, DEMS-IR-01 or
# DEMS-JKT-07 (reserved). Must equal, character for character, the id typed at `evidence:production-key`.
# DEMS_INSTALLATION_DEVICE_ID=<installation-device-id>
# DEMS_INSTALLATION_NAME=<installation display name>

# --- LCD ESP32 (included in the Core image, profile lcd) ----------------------------------------------------
# Installer sets these for the selected USB device. Enable: docker compose --profile lcd up -d lcd
# Empty URL leaves the Core bridge disabled. One Core per LCD backend. Port 8090 is loopback only.
DEMS_LCD_BACKEND_URL=
DEMS_LCD_SERIAL_DEVICE=/dev/ttyACM0
DEMS_LCD_SERIAL_GID=20
DEMS_LCD_BAUD=115200
