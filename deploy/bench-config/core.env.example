# core.env.example - template for /etc/dems/core.env on the DEMS bench host (decision D274).
#
# Built from the CODE ONLY, never from a real core.env:
#   - apps/core-server/src/config.ts and apps/core-server/src/plugins/config/load-config.ts (Core)
#   - apps/lcd-backend/app/dems_backend.py (LCD backend; dems-lcd.service loads this same file)
# Values here are placeholders or the defaults the code itself applies when a variable is unset.
#
# Copy to /etc/dems/core.env, fill in the <set-me> values, then: owner root, group dems-core, mode 0640.
# NEVER commit the filled-in file. Transfer the real one privately (scp between team machines).
#
# Legend:  [SECRET]  the value is a credential; keep it only in the real file.
#          unset     leave the line commented out to get the code default.

# ---------------------------------------------------------------------------------------------
# Core server (dems-core.service). Read once, at start, by plugins/config/load-config.ts.
# ---------------------------------------------------------------------------------------------

# Listen port: 4420 is the main instance; 4421 to 4423 are lane instances. Any other value stops the boot.
# The listen host is fixed to 127.0.0.1 in code and cannot be configured.
DEMS_CORE_PORT=4420

# Demo flag: 1 turns the demo controls on; unset, empty or 0 leaves them off. Keep 0 in production.
DEMS_DEMO_CONTROLS=0

# Log level: one of fatal, error, warn, info, debug, trace, silent. Default info.
DEMS_LOG_LEVEL=info

# Optional local LCD bridge. Must be http://127.0.0.1:<port>; never a remote host.
DEMS_LCD_BACKEND_URL=http://127.0.0.1:8090

# Capture mode: simulated (default, no worker is ever started) or real (sessions record through the worker).
DEMS_CAPTURE_MODE=<set-me: simulated|real>

# Absolute path of the capture worker program. Unset = no worker configured.
DEMS_CAPTURE_WORKER=<set-me: /absolute/path/to/capture-worker>

# Absolute path of the media root. Unset = <data dir>/media/sessions. Also read by the LCD backend for free-space checks.
DEMS_MEDIA_DIR=<set-me: /absolute/path/to/media>

# Development fence: 1 = development sources exist; unset, empty or 0 = none (production: 0).
DEMS_CAPTURE_DEV_SOURCES=0

# Absolute path of the program the development helpers run (ffmpeg). Unset = no helper program.
# DEMS_CAPTURE_HELPER_FFMPEG=<set-me: /absolute/path/to/ffmpeg>

# What the first generated test microphone plays: tone (default) or speech. Development fence only.
# DEMS_CAPTURE_DEV_FAKE_MIC=tone

# Installation identity stated by the signed manifest of a sealed recording.
# Device id: a capital letter, then capitals, digits or hyphens, 32 characters at most (e.g. DEMS-SITE-21).
DEMS_INSTALLATION_DEVICE_ID=<set-me: DEMS-SITE-NN>
# Display name: 1 to 120 printable characters, no leading or trailing space.
DEMS_INSTALLATION_NAME=<set-me>

# Absolute path of the relay program of production capture (started by the production door only).
DEMS_CAPTURE_RELAY=<set-me: /absolute/path/to/relay>
# Absolute path of the guard program of production capture (started by the production door only).
DEMS_CAPTURE_GUARD=<set-me: /absolute/path/to/guard>
# Absolute path of the socket of the capture host's address helper. Unset = helper "not configured".
DEMS_CAPTURE_ALIAS_SOCKET=<set-me: /absolute/path/to/alias.sock>
# Absolute path of the audio helper of production capture. Unset = no production microphone can be opened.
DEMS_CAPTURE_AUDIO_HELPER=<set-me: /absolute/path/to/audio-helper>

# SMART ATTACH (decision D62). 1 turns the camera segment sweep on; unset, empty or 0 leaves it off.
DEMS_CAMERA_AUTOATTACH=0
# One IPv4 /24 literal (e.g. 192.168.7.0/24). Required while DEMS_CAMERA_AUTOATTACH=1, otherwise the boot stops.
# DEMS_CAMERA_SEGMENT_CIDR=<set-me: a.b.c.0/24>
# Bench camera user name, read ONLY to test and store an auto-adopted camera. Without the pair nothing is adopted.
# DEMS_CAMERA_DEFAULT_USER=<set-me>
# [SECRET] Bench camera password (held as a Secret in code; prints [redacted]). 1 to 256 printable characters.
# DEMS_CAMERA_DEFAULT_PASSWORD=<set-me>

# Not read from this file (for reference):
#   - Database connection: the Core reads <data dir>/pg.env (keys DEMS_PG_HOST, DEMS_PG_PORT, DEMS_PG_DATABASE,
#     DEMS_PG_APP_ROLE and the [SECRET] DEMS_PG_APP_PASSWORD), data dir = <repository root>/.data.
#     The host must be 127.0.0.1 and port 5432 is refused. Any PG* variable in the environment is removed at start.
#   - Signing keys and session keys: held in the Core's key store, not in the environment. No env variable names a signer key path.
#   - Session cookie: name derived from the listen port (dems_session_<port>); no session secret variable exists.
#   - NODE_OPTIONS: only reported (set / not set) in the boot log; do not set it.

# ---------------------------------------------------------------------------------------------
# LCD backend (dems-lcd.service loads this same file, then sets its own Environment= lines,
# which win). Read by apps/lcd-backend/app/dems_backend.py. Defaults shown are the code's.
# ---------------------------------------------------------------------------------------------

# Serial device of the ESP32 front panel; tried first, then the USB identity below, then /dev/serial/by-id.
# DEMS_DEV=/dev/ttyACM0
# USB serial number / vid:pid used to find the panel when the device name changes. Empty = not used.
# DEMS_USB_SERIAL=
# DEMS_USB_VIDPID=
# Reconnect backoff in seconds (grows to 10 s).
# DEMS_USB_RETRY_S=2
# DTR / RTS lines, set once after open (0, empty or false = off).
# DEMS_DTR=1
# DEMS_RTS=1
# DEMS_BAUD=115200
# HTTP port and bind address. The API has no authentication: keep the bind on loopback.
# DEMS_PORT=8090
# DEMS_BIND=127.0.0.1
# Legacy name of the recording directory; DEMS_MEDIA_DIR above is used when this is empty. Fallback /data/rekam.
# DEMS_REKAM_DIR=
# Free-space thresholds in GB (warning / critical).
# DEMS_MIN_FREE_GB=20
# DEMS_CRIT_FREE_GB=5
# Seconds without news before a recording channel shows a warning (0 = off).
# DEMS_CH_STALE_S=0
# Default lease of a 'start' in seconds (0 = none).
# DEMS_LEASE_S=0
# Seconds of panel silence before it is reported silent.
# DEMS_PANEL_SILENT_S=10
# Status push interval in seconds.
# DEMS_PUSH_S=1.0
# Channel mode: track (one track = one channel) or device (tracks of one camera = one channel).
# DEMS_CH_MODE=track
# DEMS_CH_NAMES=CH1,CH2,CH3,CH4
# Screen identity. SATKER = work unit (line 3, may change after hand-over). CLIENT = client name (line 2, pre-delivery).
# Both must default to empty so a new unit shows the factory screen.
DEMS_SATKER=<set-me>
# DEMS_CLIENT=
# File that keeps the runtime identity across restarts (dems-lcd.service sets it).
# DEMS_IDENTITY_FILE=
# [SECRET] Provisioning key that guards writing DEMS_CLIENT (sent as header X-Provision-Key). Empty = not set.
# DEMS_PROVISION_KEY=<set-me>
# Logo push (pre-delivery layer L1). Directory default: directory of DEMS_IDENTITY_FILE, else /var/lib/dems-lcd.
# DEMS_LOGO_DIR=
# DEMS_LOGO_CHUNK=1024
# DEMS_LOGO_ACK_S=3
# DEMS_LOGO_GAP_S=0.08
# DEMS_LOGO_MAX_TRIES=3
# DEMS_LOGO_REPUSH_MIN_S=30
# DEMS_LOGO_WAIT_S=45
# DEMS_LOGO_AUTOPUSH=1
# DEMS_LOGO_MAX_BYTE=6291456
# DEMS_LOGO_MAX_W=480
# DEMS_LOGO_MAX_H=320
# Core on loopback and the console origin the LCD setup page talks to.
# DEMS_CORE_URL=http://127.0.0.1:4420
# DEMS_CORE_CONSOLE_ORIGIN=http://127.0.0.1:5173
# Lifetime of a pre-delivery setup grant in seconds.
# DEMS_SETUP_TTL_S=900

# ---------------------------------------------------------------------------------------------
# Web console (dems-console.service). NOT read from core.env: these are set in the unit and its
# drop-in. Listed here only so the whole environment is in one place.
#   DEMS_CORE_PROXY_PORT        apps/core-web/vite.config.ts: Core port the dev-server proxy forwards to (4420).
#   VITE_DEMS_CORE_MODE         apps/core-web/src/runtime/boot.ts: live or demo mode of the console.
#   VITE_DEMS_PRODUCTION_LOCK   apps/core-web/src/runtime/boot.ts: 1 = production lock (drop-in production-lock.conf).
#   VITE_DEMS_CORE_ORIGIN       apps/core-web/src/lib/core-endpoint.ts: Core origin override (unset on the bench).
# ---------------------------------------------------------------------------------------------
