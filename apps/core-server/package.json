{
  "name": "@dems/core-server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "start:camera-stub": "tsx test/support/lane-camera-stub-cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:db:drop-run": "tsx test/drop-dead-run.ts",
    "coverage": "vitest run --coverage",
    "db:create": "tsx src/db/commands/create.ts",
    "db:migrate": "tsx src/db/commands/migrate.ts",
    "db:seed": "tsx src/db/seed/cli.ts",
    "db:reset": "tsx src/db/reset/cli.ts",
    "db:status": "tsx src/db/commands/status.ts",
    "db:generate": "drizzle-kit generate",
    "evidence:dev-key": "tsx src/sealing/dev-key-cli.ts",
    "evidence:verify-export": "tsx cli/verify-export.ts"
  },
  "dependencies": {
    "@dems/capture-protocol": "*",
    "@dems/shared": "*",
    "@dems/transcriber": "*",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.9.1",
    "@fastify/websocket": "11.3.1",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "onvif": "0.8.3",
    "openapi-types": "12.1.3",
    "pg": "8.23.1",
    "rate-limiter-flexible": "11.2.1",
    "react": "19.2.3",
    "tsx": "4.23.15",
    "xml2js": "0.6.2",
    "yazl": "3.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "@types/yazl": "3.3.1",
    "@vitest/coverage-v8": "5.0.3",
    "drizzle-kit": "0.31.11",
    "oxlint": "1.86.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "ws": "8.22.0"
  }
}
