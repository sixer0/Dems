{
  "name": "@dems/transcriber",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "test:real:cpu-local": "vitest run --config vitest.real.config.ts test/real/cpu-local.real.test.ts",
    "test:real:omlx-server": "vitest run --config vitest.real.config.ts test/real/omlx-server.real.test.ts",
    "test:real:shape": "vitest run --config vitest.real.config.ts test/real/shape.real.test.ts",
    "test:real:omlx-log-excerpt": "vitest run --config vitest.real.config.ts test/real/omlx-log-excerpt.real.test.ts",
    "test:real:row77:cpu-local": "vitest run --config vitest.real.config.ts test/real/row77-cpu-local.real.test.ts",
    "test:real:row77:omlx-server": "vitest run --config vitest.real.config.ts test/real/row77-omlx-server.real.test.ts",
    "test:real:row77:df1": "vitest run --config vitest.real.config.ts test/real/row77-df1.real.test.ts",
    "test:real:row78:labels": "vitest run --config vitest.real.config.ts test/real/row78-speaker-labels.real.test.ts"
  },
  "dependencies": {
    "@dems/shared": "*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "oxlint": "1.86.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
