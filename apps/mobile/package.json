{
  "name": "@dems/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "EXPO_NO_TELEMETRY=1 NODE_OPTIONS=--dns-result-order=ipv4first expo start --localhost --port 8081",
    "start:lane": "EXPO_NO_TELEMETRY=1 NODE_OPTIONS=--dns-result-order=ipv4first expo start --localhost --port ${METRO_PORT:-8081}",
    "build": "EXPO_NO_TELEMETRY=1 expo prebuild --platform android --no-install && cd android && ./gradlew assembleDebug",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "e2e": "MAESTRO_CLI_NO_ANALYTICS=true MAESTRO_CLI_ANALYSIS_NOTIFICATION_DISABLED=true \"$HOME/.maestro/bin/maestro\" ${ANDROID_SERIAL:+--device $ANDROID_SERIAL} test e2e/maestro",
    "android": "EXPO_NO_TELEMETRY=1 expo run:android",
    "prebuild": "EXPO_NO_TELEMETRY=1 expo prebuild --platform android --no-install",
    "doctor": "EXPO_NO_TELEMETRY=1 expo-doctor",
    "deps:check": "EXPO_NO_TELEMETRY=1 expo install --check",
    "patches:apply": "sh scripts/apply-patches.sh",
    "patches:check": "sh scripts/apply-patches.sh --check",
    "reverse": "adb reverse tcp:4400 tcp:4400 && adb reverse tcp:8081 tcp:8081 && adb reverse tcp:4420 tcp:4420"
  },
  "dependencies": {
    "@dems/shared": "*",
    "@expo-google-fonts/inter": "0.4.2",
    "@expo-google-fonts/jetbrains-mono": "0.4.1",
    "@expo-google-fonts/orbitron": "0.4.2",
    "@expo/ui": "~57.0.21",
    "@gorhom/bottom-sheet": "5.2.14",
    "@hookform/resolvers": "5.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.6.2",
    "@tanstack/react-query": "5.104.0",
    "expo": "~57.0.26",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-keep-awake": "~57.0.2",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-local-authentication": "~57.0.3",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "heroui-native": "1.0.10",
    "i18next": "26.4.2",
    "lucide-react-native": "1.49.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.89.0",
    "react-i18next": "17.0.15",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "uniwind": "1.12.0",
    "victory-native": "42.0.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/react": "19.2.18",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "expo-doctor": "1.20.4",
    "jest": "29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3"
  }
}
