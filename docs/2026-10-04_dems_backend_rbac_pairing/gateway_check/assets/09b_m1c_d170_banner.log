### zz-m1c-banner-probe3.test.tsx
// SCRATCH PROBE 3 (D170): the scheduling pattern of the banner hook, outside the app. Moved out of the tree after use.
import { expect, it } from '@jest/globals';
import { act, render } from '@testing-library/react-native';
import { startTransition, useEffect, useMemo, useState, useSyncExternalStore } from 'react';
import { Text } from 'react-native';
import { bannerKindAfterResync, connectionBannerFor, nextBannerKind, type ConnectionBannerKind } from './connection-banner';
import type { CoreLinkInfo } from './contract';
import { createResyncBus, type ResyncBus } from './resync-bus';

// The hook as it is in sim-runtime-provider.tsx:517-533 (copied for the probe).
function useOld(link: CoreLinkInfo, bus: ResyncBus) {
  const [kind, setKind] = useState<ConnectionBannerKind>(() => nextBannerKind('hidden', link));
  const [seenLink, setSeenLink] = useState(link);
  if (seenLink !== link) { setSeenLink(link); setKind(nextBannerKind(kind, link)); }
  useEffect(() => bus.subscribe(() => setKind(bannerKindAfterResync)), [bus]);
  return useMemo(() => connectionBannerFor(kind), [kind]);
}
const OFF: CoreLinkInfo = { source: 'LIVE', state: 'OFFLINE', heartbeat: 'OFFLINE' };
const CONN: CoreLinkInfo = { source: 'LIVE', state: 'OFFLINE', heartbeat: 'CONNECTING' };
const ON: CoreLinkInfo = { source: 'LIVE', state: 'ONLINE', heartbeat: 'LIVE' };
function store(initial: CoreLinkInfo) { let v = initial; const ls = new Set<() => void>(); return { get: () => v, set: (n: CoreLinkInfo) => { v = n; ls.forEach((l) => l()); }, sub: (l: () => void) => { ls.add(l); return () => ls.delete(l); } }; }
let out = '';
function Host({ s, bus }: { s: ReturnType<typeof store>; bus: ResyncBus }) {
  const link = useSyncExternalStore(s.sub, s.get, s.get);
  const banner = useOld(link, bus);
  out = banner.kind;
  return <Text>{banner.kind}</Text>;
}
let bump: (() => void) | null = null;
function Other() { const [, set] = useState(0); bump = () => set((n) => n + 1); return null; }

const cases: Record<string, (s: ReturnType<typeof store>, bus: ResyncBus) => Promise<void>> = {
  'same act: link ONLINE then emit': async (s, bus) => { act(() => { s.set(ON); bus.emit(); }); },
  'emit in a transition-like lane, link sync': async (s, bus) => { act(() => { s.set(ON); startTransition(() => bus.emit()); }); },
  'pending low-lane update elsewhere, then link+emit': async (s, bus) => { act(() => { startTransition(() => bump?.()); s.set(ON); bus.emit(); }); },
  'emit outside act then link in act': async (s, bus) => { bus.emit(); await act(async () => { s.set(ON); }); },
  'async act: link then emit then await': async (s, bus) => { await act(async () => { s.set(ON); bus.emit(); await Promise.resolve(); }); },
  'emit queued in transition before the link': async (s, bus) => { act(() => { startTransition(() => bus.emit()); s.set(ON); }); },
};
for (const [name, run] of Object.entries(cases)) {
  it(name, async () => {
    const s = store(OFF); const bus = createResyncBus();
    render(<><Host s={s} bus={bus} /><Other /></>);
    act(() => s.set(CONN)); act(() => s.set(OFF));
    expect(out).toBe('offline');
    await run(s, bus);
    await act(async () => { await Promise.resolve(); });
    console.log(`CASE ${name}: ${out}`);
    expect(true).toBe(true);
  });
}
