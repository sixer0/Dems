    bed.goDown(); await flush(); await bed.elapse(1_000, 250);
    await act(async () => { await new Promise((r) => setTimeout(r, 1100)); });
    bed.comeBack(); for (let i = 0; i < 16; i += 1) await bed.elapse(250, 250);
    console.log(`VARIANT ${name}: ${seen}`);
    expect(true).toBe(true);
  });
