// SCRATCH PROBE (D170 diagnosis; moved out of the tree after use). W68's wait-only probe on W68's monitor bed, imported read-only.
import '@/features/session-live/testing/monitor-test-setup';
import '@/navigation/testing/router-harness';
import { afterEach, beforeEach, expect, it, jest } from '@jest/globals';
import { act, screen } from '@testing-library/react-native';
import * as bannerModule from './connection-banner';
import { renderLiveMonitor, resetLiveMonitorBed, type LiveMonitorBed } from '@/features/session-live/testing/live-monitor-bed';

let bed: LiveMonitorBed | null = null;
beforeEach(async () => { await resetLiveMonitorBed(); });
afterEach(() => { bed?.stop(); bed = null; jest.restoreAllMocks(); });
const rt = () => (globalThis as unknown as { __DEMS_DEBUG__?: { runtime?: () => { coreLink?: { state: string; heartbeat?: string }; banner?: string } } }).__DEMS_DEBUG__?.runtime?.();

for (const wait of [false, true]) {
  it(`wait=${wait}`, async () => {
    const b = await renderLiveMonitor();
    bed = b;
    await b.openMonitor();
    b.setReachable(false);
    await b.flush();
    await b.elapse(1_000, 250);
    if (wait) await act(async () => { await new Promise((r) => setTimeout(r, 1100)); });
    const log: string[] = [];
    const real1 = bannerModule.nextBannerKind;
    const real2 = bannerModule.bannerKindAfterResync;
    const real3 = bannerModule.connectionBannerFor;
    jest.spyOn(bannerModule, 'nextBannerKind').mockImplementation((c, l) => { const r = real1(c, l); log.push(`next(${c},${l.state}/${l.heartbeat})=${r}`); return r; });
    jest.spyOn(bannerModule, 'bannerKindAfterResync').mockImplementation((c) => { const r = real2(c); log.push(`resync(${c})=${r}`); return r; });
    jest.spyOn(bannerModule, 'connectionBannerFor').mockImplementation((k) => { log.push(`for(${k})`); return real3(k); });
    b.setReachable(true);
    await b.elapse(4_000, 250);
    const r = rt();
    console.log(`PROBE wait=${wait} ${r?.coreLink?.state}/${r?.coreLink?.heartbeat} banner=${r?.banner}\n  ${log.join(' | ')}`);
    expect(true).toBe(true);
  });
}
