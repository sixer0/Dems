## the probe file
// TEMPORARY PROBE (row M1 follow-up, F5): what happens today when "Keep session" is pressed while a cancel is in flight.
import './testing/session-new-test-setup';
import '@/navigation/testing/router-harness';
import { afterEach, beforeEach, expect, it } from '@jest/globals';
import { act, fireEvent, screen } from '@testing-library/react-native';
import { router } from 'expo-router';
import { PRECHECK_TOTAL_MAX_MS } from '@dems/shared/sim';
import { renderLiveSessionNew, resetLiveSessionNewBed, type LiveSessionNewBed } from './testing/live-session-new-bed';

let bed: LiveSessionNewBed | null = null;
beforeEach(async () => { await resetLiveSessionNewBed(); });
afterEach(() => { bed?.stop(); bed = null; });

async function fillStep1(): Promise<void> {
  const s = () => act(async () => {});
  fireEvent.press(screen.getByTestId('session-new-scan')); await s();
  fireEvent.press(screen.getByTestId('session-new-subject-TERSANGKA')); await s();
  fireEvent.changeText(screen.getByTestId('session-new-subject-name'), 'Ahmad Fauzi'); await s();
}

for (const order of ['delta-first', 'answer-first'] as const) {
  it(`probe ${order}`, async () => {
    const b = await renderLiveSessionNew();
    bed = b;
    await b.openFlow();
    await fillStep1();
    fireEvent.press(screen.getByTestId('session-new-next'));
    await b.flush();
    await b.elapse(200);
    await b.runCore(PRECHECK_TOTAL_MAX_MS);
    act(() => router.back());
    expect(screen.getByText('Cancel this session?')).toBeTruthy();
    b.order = order;
    b.answerDelayMs = 1_000;
    fireEvent.press(screen.getByTestId('back-guard-leave'));
    await b.flush();
    const stay = screen.getByTestId('back-guard-stay');
    const log: string[] = [`stay disabled=${String(stay.props.accessibilityState?.disabled)}`];
    fireEvent.press(stay);
    await b.flush();
    log.push(`after Keep: dialog=${screen.queryByText('Cancel this session?') !== null} path=${b.app.getPathname()}`);
    await b.elapse(1_200);
    if (order === 'answer-first') { b.sendHeldDeltas(); await b.flush(); await b.elapse(200); }
    log.push(`after answer: dialog=${screen.queryByText('Cancel this session?') !== null} path=${b.app.getPathname()} session=${String(b.state().session?.state ?? null)} cancels=${b.requests('cancelSession').length} step=${['1','2','3'].find((n) => screen.queryByTestId(`session-new-step-${n}`) !== null) ?? '-'}`);
    console.log(`PROBE ${order}\n  ${log.join('\n  ')}`);
  });
}
