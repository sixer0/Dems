diff --git b/apps/core-server/test/helpers/db/__tests__/dead-run.db.test.ts b/apps/core-server/test/helpers/db/__tests__/dead-run.db.test.ts
new file mode 100644
index 0000000..bc04aef
--- /dev/null
+++ b/apps/core-server/test/helpers/db/__tests__/dead-run.db.test.ts
@@ -0,0 +1,237 @@
+// Row W11b, decision D111, against the real server: `TestRun.dropDeadRun(prefix)` removes the
+// databases of one named run whose owner is gone, and refuses everything else.
+//
+// The dead runs of this file are real runs of its own, closed without a teardown (which is what a
+// stopped `test:db` leaves: the liveness lock is gone with the session, the databases stay). The
+// run that is alive is the one this very file runs in, and a second one beside it.
+//
+// The stand-in tests of the same behaviour: `dead-run.test.ts`.
+import { afterAll, describe, expect, it, vi } from 'vitest';
+import { APP_ROLE, OWNER_ROLE } from '../constants';
+import { waitForSessionsToEnd } from '../ddl';
+import { DbGuardError, DbTestHelperError } from '../errors';
+import { TestRun, providedRun, useTestDatabase } from '../index';
+import { runnerOf } from '../session';
+import { PROBE_TABLE, SELFTEST_TEMPLATE } from '../testing/probe-hooks';
+import { probeResolver, startPrivateRun } from '../testing/private-run';
+
+// Limits as caps, not waits (decision D110). A clone or a template that a test asks for waits
+// for the clone lock, which another run on this host may hold for seconds while it builds its
+// bulk template; with the runner's default of 5 s such a wait failed a healthy test under load.
+vi.setConfig({ testTimeout: 120_000, hookTimeout: 180_000 });
+
+const db = useTestDatabase({ template: SELFTEST_TEMPLATE });
+const started: TestRun[] = [];
+/** The runs this file stopped on purpose. A test that fails half-way leaves their databases. */
+const stoppedPrefixes: string[] = [];
+
+/** Short, so that a test does not wait the three seconds a person's call waits. */
+const SETTLE = { settleMs: 150 };
+
+afterAll(async () => {
+  for (const run of started) if (!run.closed) await run.teardown();
+  // Nothing of this file stays behind, also when a test failed: the stopped runs go by name.
+  const cleaner = await startPrivateRun('dz');
+  try {
+    for (const prefix of stoppedPrefixes) await cleaner.dropDeadRun(prefix, SETTLE).catch(() => undefined);
+  } finally {
+    await cleaner.teardown();
+  }
+});
+
+/**
+ * The databases that neither come nor go while tests run: not a test database of some run, and
+ * not the copy the reset routine keeps for a moment (`<name>_next`, `<name>_prev`).
+ */
+function settled(names: readonly string[]): string[] {
+  return names.filter((name) => !name.startsWith('dems_test_') && !name.endsWith('_next') && !name.endsWith('_prev'));
+}
+
+async function privateRun(tag: string): Promise<TestRun> {
+  const run = await startPrivateRun(tag);
+  started.push(run);
+  return run;
+}
+
+async function namesWithPrefix(prefix: string): Promise<string[]> {
+  const rows = await db.ownerPool().query<{ name: string }>(
+    'SELECT datname::text AS name FROM pg_database WHERE starts_with(datname, $1) ORDER BY 1',
+    [prefix],
+  );
+  return rows.rows.map((row) => row.name);
+}
+
+async function refusal(action: () => Promise<unknown>): Promise<DbTestHelperError> {
+  try {
+    await action();
+  } catch (error) {
+    if (error instanceof DbTestHelperError) return error;
+    throw error;
+  }
+  throw new Error('not refused');
+}
+
+/** A run with a clone and two locked templates whose owner "is stopped": closed, not torn down. */
+async function stoppedRun(tag: string): Promise<{ prefix: string; names: string[]; identity: TestRun['identity'] }> {
+  const run = await privateRun(tag);
+  const clone = await run.createDatabase({ template: 'seed', slug: 'left_behind' });
+  await clone.appPool().query(`INSERT INTO ${PROBE_TABLE} (token_hash, origin) VALUES ('t', 'left')`);
+  // The stop: the run's process is gone, its session and its liveness lock with it.
+  await run.close();
+  const prefix = run.identity.prefix;
+  stoppedPrefixes.push(prefix);
+  const names = await namesWithPrefix(prefix);
+  expect(names).toEqual([clone.name, `${prefix}tpl_schema`, `${prefix}tpl_seed`]);
+  return { prefix, names, identity: run.identity };
+}
+
+describe('a run that was stopped before its teardown', () => {
+  it('is removed by name: its clone and its locked templates; every other database stays', async () => {
+    const stopped = await stoppedRun('dd');
+    const operator = await privateRun('op');
+    const others = settled(await namesWithPrefix(''));
+    const templatesOfThisRun = (await namesWithPrefix(db.run.identity.prefix)).filter((name) => name.includes('_tpl_'));
+    // The stale sweep does not take it: it started seconds ago.
+    const swept = await operator.sweepStale();
+    for (const name of stopped.names) expect(swept.dropped).not.toContain(name);
+    expect(swept.keptYounger).toEqual(expect.arrayContaining(stopped.names));
+
+    const report = await operator.dropDeadRun(stopped.prefix, SETTLE);
+
+    expect(report.prefix).toBe(stopped.prefix);
+    expect(report.failed).toEqual([]);
+    expect(report.remaining).toEqual([]);
+    expect([...report.dropped].sort()).toEqual(stopped.names);
+    // The clone went before the templates.
+    expect(report.dropped[0]).toBe(stopped.names[0]);
+    expect(await namesWithPrefix(stopped.prefix)).toEqual([]);
+    // Everything else is there: the project's own databases (whichever exist), the maintenance
+    // database, the templates of PostgreSQL, and the run in progress with this file's own clone.
+    const now = await namesWithPrefix('');
+    expect(settled(now)).toEqual(others);
+    expect(others).toEqual(expect.arrayContaining(['postgres', 'template0', 'template1']));
+    for (const name of [db.name, ...templatesOfThisRun]) expect(now, name).toContain(name);
+    expect((await db.appPool().query<{ db: string }>('SELECT current_database()::text AS db')).rows).toEqual([{ db: db.name }]);
+    // Once more: nothing is left to drop.
+    expect(await operator.dropDeadRun(stopped.prefix, SETTLE)).toMatchObject({ dropped: [], remaining: [], failed: [] });
+    console.log(`[test:db] dead run: dropped ${report.dropped.length} database(s) of a stopped run in ${Math.round(report.ms)} ms (settle ${SETTLE.settleMs} ms)`);
+  });
+});
+
+describe('a run that is alive', () => {
+  it('the run this file runs in: refused with RUN_ALIVE after one statement; its templates and clones stay', async () => {
+    const operator = await privateRun('ol');
+    const live = providedRun().prefix;
+    const before = await namesWithPrefix(live);
+    expect(before).toContain(db.name);
+    expect(before.some((name) => name.includes('_tpl_'))).toBe(true);
+    const sent = operator.statementCount;
+
+    const error = await refusal(() => operator.dropDeadRun(live, SETTLE));
+
+    expect(error.code).toBe('RUN_ALIVE');
+    expect(error.message).toContain(`the run ${live}* is alive`);
+    expect(error.message).toContain('Nothing was dropped');
+    // One statement: the question whether the liveness lock is free.
+    expect(operator.statementCount).toBe(sent + 1);
+    // The other worker's files come and go meanwhile; what was there and is this file's is there.
+    const after = await namesWithPrefix(live);
+    expect(after).toContain(db.name);
+    for (const name of before.filter((entry) => entry.includes('_tpl_'))) expect(after, name).toContain(name);
+  });
+
+  it('a second run beside it, with a clone and locked templates: refused; nothing of it changes', async () => {
+    const alive = await privateRun('al');
+    const clone = await alive.createDatabase({ template: 'seed', slug: 'in_use' });
+    const before = await alive.listDatabases();
+    expect(before.map((row) => row.name)).toEqual([clone.name, `${alive.identity.prefix}tpl_schema`, `${alive.identity.prefix}tpl_seed`]);
+    const operator = await privateRun('oa');
+
+    expect((await refusal(() => operator.dropDeadRun(alive.identity.prefix, SETTLE))).code).toBe('RUN_ALIVE');
+
+    expect(await alive.listDatabases()).toEqual(before);
+    expect((await clone.appPool().query<{ n: number }>(`SELECT count(*)::int AS n FROM ${PROBE_TABLE}`)).rows).toEqual([{ n: 1 }]);
+  });
+});
+
+describe('a dead run that somebody still works in', () => {
+  it.each([
+    ['the runtime role', 'app', APP_ROLE],
+    ['the owner role, which a forced drop would end', 'owner', OWNER_ROLE],
+  ] as const)('a session of %s on its clone: refused, the session is not ended; after it has left the run is removed', async (_label, kind, role) => {
+    const stopped = await stoppedRun(kind === 'app' ? 'da' : 'do');
+    const clone = stopped.names[0] ?? '';
+    // A worker of that run that outlived its owner, with a connection of its own.
+    const worker = await TestRun.attach(stopped.identity, { resolveDefinition: probeResolver() });
+    const pool = worker.poolOn(clone, kind, 'dems-w11b-still-here');
+    const held = await pool.connect();
+    held.on('error', () => undefined);
+    const operator = await privateRun(kind === 'app' ? 'oq' : 'or');
+    try {
+      await held.query('SELECT 1');
+
+      const error = await refusal(() => operator.dropDeadRun(stopped.prefix, SETTLE));
+
+      expect(error.code).toBe('SESSIONS_REMAIN');
+      expect(error.message).toContain(`1 of role ${role} (application "dems-w11b-still-here") on ${clone}`);
+      expect(error.message).toContain('no session was ended');
+      expect(await namesWithPrefix(stopped.prefix)).toEqual(stopped.names);
+      // Nobody ended it: it still answers, on the database that was not dropped.
+      expect((await held.query<{ db: string }>('SELECT current_database()::text AS db')).rows).toEqual([{ db: clone }]);
+    } finally {
+      held.release();
+      await pool.end();
+      await worker.close();
+    }
+    // The session is closed; the server needs a moment to end its backend.
+    expect(await waitForSessionsToEnd(runnerOf(db.ownerPool()), clone, 5_000)).toEqual([]);
+    const report = await operator.dropDeadRun(stopped.prefix, SETTLE);
+    expect(report.remaining).toEqual([]);
+    expect([...report.dropped].sort()).toEqual(stopped.names);
+    expect(await namesWithPrefix(stopped.prefix)).toEqual([]);
+  });
+});
+
+describe('what is not a run of its own to remove', () => {
+  it('the demo database, the lanes, the maintenance database, the templates of PostgreSQL, a database name: refused before a statement is sent', async () => {
+    const operator = await privateRun('og');
+    const all = settled(await namesWithPrefix(''));
+    const sent = operator.statementCount;
+    for (const text of [
+      'dems_demo',
+      'dems_demo_',
+      'dems_lane_1',
+      'dems_lane_2',
+      'dems_lane_3',
+      'postgres',
+      'template0',
+      'template1',
+      'dems_test_',
+      db.name,
+      providedRun().prefix.slice(0, -1),
+      `${providedRun().prefix}tpl_schema`,
+      'dems_test_step_%',
+    ]) {
+      const error = await refusal(() => operator.dropDeadRun(text, SETTLE));
+      expect(error, text).toBeInstanceOf(DbGuardError);
+      expect(error.message, text).toContain('refused before any statement');
+    }
+    // Its own run: the teardown is the way.
+    const own = await refusal(() => operator.dropDeadRun(operator.identity.prefix, SETTLE));
+    expect(own).toBeInstanceOf(DbGuardError);
+    expect(own.message).toContain('is this run');
+    expect(operator.statementCount).toBe(sent);
+    const after = await namesWithPrefix('');
+    expect(settled(after)).toEqual(all);
+    expect(after).toContain(db.name);
+  });
+
+  it('a test file attached to a run cannot remove another run', async () => {
+    const stopped = await stoppedRun('dn');
+    expect((await refusal(() => db.run.dropDeadRun(stopped.prefix, SETTLE))).code).toBe('RUN_NOT_OWNER');
+    expect(await namesWithPrefix(stopped.prefix)).toEqual(stopped.names);
+    // Removed by a run that may: nothing of this test stays behind.
+    const operator = await privateRun('on');
+    expect((await operator.dropDeadRun(stopped.prefix, SETTLE)).remaining).toEqual([]);
+  });
+});
diff --git b/apps/core-server/test/helpers/db/__tests__/dead-run.test.ts b/apps/core-server/test/helpers/db/__tests__/dead-run.test.ts
new file mode 100644
index 0000000..7a41753
--- /dev/null
+++ b/apps/core-server/test/helpers/db/__tests__/dead-run.test.ts
@@ -0,0 +1,368 @@
+// Row W11b, decision D111: a run that was stopped before its teardown leaves its databases; the
+// stale sweep takes them after six hours. `TestRun.dropDeadRun(prefix)` removes ONE such run by
+// name at once, after showing that it is dead:
+//
+//   - the text is exactly a run prefix, and not the caller's own: anything else is refused before
+//     a statement is sent (the demo database, a lane, `postgres`, the templates of PostgreSQL);
+//   - no session holds the run's liveness lock (a run that is alive is refused, its templates too);
+//   - no client session of any role is on its databases, twice, a settle time apart.
+//
+// No database and no socket here: the stand-in cluster. Against the real server:
+// `dead-run.db.test.ts`.
+import { afterEach, describe, expect, it } from 'vitest';
+import { DEAD_RUN_SETTLE_MS, LOCK_CLASS, OWNER_ROLE, STALE_AFTER_SECONDS } from '../constants';
+import { DbGuardError, DbTestHelperError } from '../errors';
+import { injectedResolver, type TemplateDefinition } from '../hooks';
+import { createRunIdentity, guardDeadRunDatabase, livenessKey, parseRunPrefix, type RunIdentity } from '../names';
+import { TestRun, type RunOptions } from '../run';
+import { FakeCluster, fakeDataDir, type FakeDatabase } from '../testing/fake-cluster';
+
+const NOW_MS = Date.UTC(2026, 9, 4, 11, 0, 0);
+const NOW_SECONDS = NOW_MS / 1000;
+const TEMPLATES: TemplateDefinition[] = [
+  { key: 'schema', base: 'empty', build: async () => undefined },
+  { key: 'seed', base: 'schema', build: async () => undefined },
+];
+const cleanups: Array<() => void | Promise<void>> = [];
+
+function stampAt(seconds: number, tail: string): string {
+  return `${seconds.toString(36).padStart(6, '0')}${tail}`;
+}
+
+/** A run that was stopped forty minutes ago: far younger than the six hours of the stale sweep. */
+const STOPPED = createRunIdentity('step_64m', stampAt(NOW_SECONDS - 40 * 60, 'g5'));
+const STOPPED_DATABASES = [`${STOPPED.prefix}f01_backpressure`, `${STOPPED.prefix}tpl_schema`, `${STOPPED.prefix}tpl_seed`];
+/** Another row's run, started a minute ago. */
+const NEIGHBOUR = createRunIdentity('step_67', stampAt(NOW_SECONDS - 60, 'y7'));
+const BYSTANDERS = ['dems_demo', 'dems_lane_1', 'dems_lane_2', 'dems_lane_3', `${NEIGHBOUR.prefix}f01_identity`, `${NEIGHBOUR.prefix}tpl_schema`];
+
+function clusterWithTheStoppedRun(): FakeCluster {
+  const cluster = new FakeCluster([...BYSTANDERS, `${STOPPED.prefix}f01_backpressure`]);
+  cluster.add(`${STOPPED.prefix}tpl_schema`, { isTemplate: true, allowConnections: false });
+  cluster.add(`${STOPPED.prefix}tpl_seed`, { isTemplate: true, allowConnections: false });
+  return cluster;
+}
+
+async function ownerRun(cluster: FakeCluster, options: RunOptions = {}): Promise<TestRun> {
+  const data = fakeDataDir();
+  cleanups.push(data.remove);
+  const run = await TestRun.start({
+    env: { DEMS_TEST_STEP: '33c' },
+    dataDir: data.dir,
+    clientFactory: cluster.factory,
+    probe: async () => undefined,
+    now: () => NOW_MS,
+    sessionDrainMs: 30,
+    dropRetry: { attempts: 5, pauseMs: 0 },
+    resolveDefinition: injectedResolver(TEMPLATES),
+    ...options,
+  });
+  cleanups.push(() => run.close());
+  return run;
+}
+
+async function attachedRun(cluster: FakeCluster, identity: RunIdentity): Promise<TestRun> {
+  const data = fakeDataDir();
+  cleanups.push(data.remove);
+  const run = await TestRun.attach(identity, { dataDir: data.dir, clientFactory: cluster.factory, resolveDefinition: injectedResolver(TEMPLATES) });
+  cleanups.push(() => run.close());
+  return run;
+}
+
+async function refusal(action: () => Promise<unknown>): Promise<DbTestHelperError> {
+  try {
+    await action();
+  } catch (error) {
+    if (error instanceof DbTestHelperError) return error;
+    throw error;
+  }
+  throw new Error('not refused');
+}
+
+function fakeOf(cluster: FakeCluster, name: string): FakeDatabase {
+  const database = cluster.databases.get(name);
+  if (database === undefined) throw new Error(`the stand-in cluster has no database ${name}`);
+  return database;
+}
+
+function locksOn(cluster: FakeCluster, key: number): string[] {
+  return cluster.statements.filter((statement) => statement.values[1] === key && statement.values[0] === LOCK_CLASS).map((statement) => statement.text);
+}
+
+afterEach(async () => {
+  for (const cleanup of cleanups.splice(0).reverse()) await cleanup();
+});
+
+const NOT_A_RUN_PREFIX: Array<[string, unknown]> = [
+  ['the demo database', 'dems_demo'],
+  ['the demo database with an underscore', 'dems_demo_'],
+  ['a copy the reset keeps', 'dems_demo_prev'],
+  ['a lane', 'dems_lane_1'],
+  ['a lane with an underscore', 'dems_lane_1_'],
+  ['the maintenance database', 'postgres'],
+  ['a template of PostgreSQL', 'template0'],
+  ['the other template of PostgreSQL', 'template1'],
+  ['a proof database', 'dems_proof_drizzle_20261004003235_a'],
+  ['the test prefix alone', 'dems_test_'],
+  ['a label without a stamp', 'dems_test_step_64m_'],
+  ['a run prefix without its last underscore', STOPPED.prefix.slice(0, -1)],
+  ['a database name of the run', `${STOPPED.prefix}f01_backpressure`],
+  ['a template name of the run', `${STOPPED.prefix}tpl_schema`],
+  ['a run prefix with a second underscore', `${STOPPED.prefix}_`],
+  ['a pattern', 'dems_test_step_64m_%'],
+  ['a pattern in place of the stamp', 'dems_test_step_64m_________'],
+  ['upper case', STOPPED.prefix.toUpperCase()],
+  ['a stamp of seven characters', 'dems_test_step_64m_tmdoqjg_'],
+  ['a label of thirteen characters', 'dems_test_step_abcdefghijklm_tmdoqjg5_'],
+  ['a leading space', ` ${STOPPED.prefix}`],
+  ['a line break at the end', `${STOPPED.prefix}\n`],
+  ['a quote', `${STOPPED.prefix}"; DROP DATABASE dems_demo; --`],
+  ['the empty text', ''],
+  ['a number', 42],
+  ['null', null],
+  ['undefined', undefined],
+];
+
+describe('a run prefix, and nothing else', () => {
+  it('is dems_test_<label>_<stamp>_ with its last underscore', () => {
+    expect(parseRunPrefix(STOPPED.prefix)).toEqual(STOPPED);
+    expect(parseRunPrefix('dems_test_local_tmd0a1b2_')).toEqual(createRunIdentity('local', 'tmd0a1b2'));
+    expect(parseRunPrefix('dems_test_step_abcdefghijkl_00000000_')?.label).toBe('step_abcdefghijkl');
+  });
+
+  it.each(NOT_A_RUN_PREFIX)('%s is not one', (_label, value) => {
+    expect(parseRunPrefix(value)).toBeNull();
+  });
+});
+
+describe('the guard of a named dead run', () => {
+  const own = createRunIdentity('step_33c', stampAt(NOW_SECONDS, 'a1'));
+
+  it('passes the databases of the run that was named, and only those', () => {
+    for (const name of STOPPED_DATABASES) expect(guardDeadRunDatabase(name, own, { run: STOPPED })).toBe(name);
+    for (const name of [...BYSTANDERS, 'postgres', 'template0', 'template1', `${own.prefix}f01_mine`, STOPPED.prefix, 'dems_test_handmade', 42, null]) {
+      expect(() => guardDeadRunDatabase(name, own, { run: STOPPED }), String(name)).toThrow(DbGuardError);
+      expect(() => guardDeadRunDatabase(name, own, { run: STOPPED }), String(name)).toThrow('refused before any statement');
+    }
+  });
+
+  it('never passes a database of the caller\'s own run, whatever is claimed', () => {
+    expect(() => guardDeadRunDatabase(`${own.prefix}f01_mine`, own, { run: own })).toThrow('belongs to this run');
+    expect(() => guardDeadRunDatabase(`${own.prefix}tpl_schema`, own, { run: own })).toThrow(DbGuardError);
+  });
+});
+
+describe('dropDeadRun: refused before a statement is sent', () => {
+  it.each(NOT_A_RUN_PREFIX)('%s', async (_label, value) => {
+    const cluster = clusterWithTheStoppedRun();
+    const run = await ownerRun(cluster);
+    const sent = cluster.statements.length;
+    const counted = run.statementCount;
+    const names = cluster.names();
+
+    const error = await refusal(() => run.dropDeadRun(value as string, { settleMs: 0 }));
+
+    expect(error).toBeInstanceOf(DbGuardError);
+    expect(error.code).toBe('GUARD_NOT_A_TEST_DATABASE');
+    expect(error.message).toContain('refused before any statement');
+    expect(error.message).toContain('is not the prefix of a test run');
+    expect(cluster.statements).toHaveLength(sent);
+    expect(run.statementCount).toBe(counted);
+    expect(cluster.names()).toEqual(names);
+  });
+
+  it('the caller\'s own run: its teardown is the way', async () => {
+    const cluster = clusterWithTheStoppedRun();
+    const run = await ownerRun(cluster);
+    await run.createDatabase({ template: 'schema', slug: 'mine' });
+    const sent = cluster.statements.length;
+    const names = cluster.names();
+
+    const error = await refusal(() => run.dropDeadRun(run.identity.prefix, { settleMs: 0 }));
+
+    expect(error).toBeInstanceOf(DbGuardError);
+    expect(error.code).toBe('GUARD_NOT_STALE');
+    expect(error.message).toContain('is this run');
+    expect(cluster.statements).toHaveLength(sent);
+    expect(cluster.names()).toEqual(names);
+  });
+
+  it('a test file attached to a run cannot, and a closed run cannot', async () => {
+    const cluster = clusterWithTheStoppedRun();
+    const owner = await ownerRun(cluster);
+    const file = await attachedRun(cluster, owner.identity);
+    const sent = cluster.statements.length;
+    expect((await refusal(() => file.dropDeadRun(STOPPED.prefix, { settleMs: 0 }))).code).toBe('RUN_NOT_OWNER');
+    await owner.close();
+    expect((await refusal(() => owner.dropDeadRun(STOPPED.prefix, { settleMs: 0 }))).code).toBe('RUN_CLOSED');
+    expect(cluster.statements).toHaveLength(sent);
+    for (const name of STOPPED_DATABASES) expect(cluster.databases.has(name)).toBe(true);
+  });
+});
+
+describe('dropDeadRun: a run that is alive', () => {
+  it('is refused with RUN_ALIVE after one statement, the question; its clone and its locked templates stay', async () => {
+    const cluster = clusterWithTheStoppedRun();
+    // The owner of that run still exists: another session holds its liveness lock.
+    cluster.locksHeldElsewhere.add(livenessKey(STOPPED.stamp));
+    const run = await ownerRun(cluster);
+    const sent = cluster.statements.length;
+    const names = cluster.names();
+
+    const error = await refusal(() => run.dropDeadRun(STOPPED.prefix, { settleMs: 0 }));
+
+    expect(error.code).toBe('RUN_ALIVE');
+    expect(error.message).toContain(`the run ${STOPPED.prefix}* is alive`);
+    expect(error.message).toContain(`advisory lock ${LOCK_CLASS}, ${livenessKey(STOPPED.stamp)}`);
+    expect(error.message).toContain('Nothing was dropped');
+    expect(cluster.statements.slice(sent).map((statement) => statement.text)).toEqual(['SELECT pg_try_advisory_lock($1::int, $2::int) AS locked']);
+    expect(cluster.databaseStatements()).toEqual([]);
+    expect(cluster.names()).toEqual(names);
+    expect(fakeOf(cluster, `${STOPPED.prefix}tpl_schema`)).toMatchObject({ isTemplate: true, allowConnections: false });
+  });
+
+  it('a run started a minute ago by another row: alive, refused, untouched', async () => {
+    const cluster = clusterWithTheStoppedRun();
+    cluster.locksHeldElsewhere.add(livenessKey(NEIGHBOUR.stamp));
+    const run = await ownerRun(cluster);
+    expect((await refusal(() => run.dropDeadRun(NEIGHBOUR.prefix, { settleMs: 0 }))).code).toBe('RUN_ALIVE');
+    expect(cluster.databases.has(`${NEIGHBOUR.prefix}f01_identity`)).toBe(true);
