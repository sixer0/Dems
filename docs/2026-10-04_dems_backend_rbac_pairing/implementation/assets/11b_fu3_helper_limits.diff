diff --git b/apps/core-server/test/helpers/db/__tests__/limits-own.db.test.ts b/apps/core-server/test/helpers/db/__tests__/limits-own.db.test.ts
new file mode 100644
index 0000000..6db2861
--- /dev/null
+++ b/apps/core-server/test/helpers/db/__tests__/limits-own.db.test.ts
@@ -0,0 +1,66 @@
+// Decision D114: the helper only RAISES the runner's limits, and only when it is imported. What a
+// test file sets for itself afterwards wins, LOWER or HIGHER. This file sets one of each: a test
+// limit below the helper's 120 s and a hook limit above its 180 s. Both must be what applies.
+//
+// Fourteen database test files of the module rows set limits below the caps (60 s and 120 s) and
+// then call `useTestDatabase`, in that order: they keep them, as this file keeps its own.
+import { afterAll, beforeAll, describe, expect, it, vi } from 'vitest';
+import { DB_HOOK_TIMEOUT_MS, DB_TEST_TIMEOUT_MS } from '../constants';
+import { currentTestLimits, isNoLimit, providedRun, useTestDatabase } from '../index';
+import { SELFTEST_TEMPLATE } from '../testing/probe-hooks';
+
+/** What the helper had set when it was imported, before this file set anything. */
+const fromTheHelper = currentTestLimits();
+
+const OWN_TEST_TIMEOUT_MS = 30_000;
+const OWN_HOOK_TIMEOUT_MS = 400_000;
+vi.setConfig({ testTimeout: OWN_TEST_TIMEOUT_MS, hookTimeout: OWN_HOOK_TIMEOUT_MS });
+
+// As the module rows' files do it: the file's own limits first, then the helper's entry.
+const db = useTestDatabase({ template: SELFTEST_TEMPLATE });
+/** Read right after the call: the entry must not have raised what the file set. */
+const afterTheEntry = currentTestLimits();
+
+let inBeforeAll: ReturnType<typeof currentTestLimits> = null;
+
+beforeAll(() => {
+  inBeforeAll = currentTestLimits();
+});
+
+afterAll(() => {
+  expect(currentTestLimits()).toEqual({ testTimeout: OWN_TEST_TIMEOUT_MS, hookTimeout: OWN_HOOK_TIMEOUT_MS });
+});
+
+describe('a database test file that sets its own limits', () => {
+  it('runs in a run of the database tests, and the helper had raised the limits when it was imported', () => {
+    expect(providedRun().prefix).toMatch(/^dems_test_/);
+    // At least the caps; or none at all, in a run that was started without limits.
+    const test = fromTheHelper?.testTimeout ?? Number.NaN;
+    const hook = fromTheHelper?.hookTimeout ?? Number.NaN;
+    expect(isNoLimit(test) || test >= DB_TEST_TIMEOUT_MS, String(test)).toBe(true);
+    expect(isNoLimit(hook) || hook >= DB_HOOK_TIMEOUT_MS, String(hook)).toBe(true);
+  });
+
+  it('keeps a test limit that is LOWER than the cap', ({ task }) => {
+    expect(OWN_TEST_TIMEOUT_MS).toBeLessThan(DB_TEST_TIMEOUT_MS);
+    expect(task.timeout).toBe(OWN_TEST_TIMEOUT_MS);
+  });
+
+  it('keeps a hook limit that is HIGHER than the cap', () => {
+    expect(OWN_HOOK_TIMEOUT_MS).toBeGreaterThan(DB_HOOK_TIMEOUT_MS);
+    expect(inBeforeAll).toEqual({ testTimeout: OWN_TEST_TIMEOUT_MS, hookTimeout: OWN_HOOK_TIMEOUT_MS });
+  });
+
+  it('the call of useTestDatabase leaves the file\'s own limits as they are', () => {
+    expect(afterTheEntry).toEqual({ testTimeout: OWN_TEST_TIMEOUT_MS, hookTimeout: OWN_HOOK_TIMEOUT_MS });
+  });
+
+  it('and the helper does not raise them again while the file runs, also when the file uses its database', async ({ task }) => {
+    const rows = await db.ownerPool().query<{ db: string }>('SELECT current_database()::text AS db');
+    expect(rows.rows).toEqual([{ db: db.name }]);
+    const more = await db.another({ slug: 'limits_own_more' });
+    await more.drop();
+    expect(currentTestLimits()).toEqual({ testTimeout: OWN_TEST_TIMEOUT_MS, hookTimeout: OWN_HOOK_TIMEOUT_MS });
+    expect(task.timeout).toBe(OWN_TEST_TIMEOUT_MS);
+  });
+});
diff --git b/apps/core-server/test/helpers/db/__tests__/limits.db.test.ts b/apps/core-server/test/helpers/db/__tests__/limits.db.test.ts
new file mode 100644
index 0000000..b60fabc
--- /dev/null
+++ b/apps/core-server/test/helpers/db/__tests__/limits.db.test.ts
@@ -0,0 +1,69 @@
+// Decision D114, in a run of the database tests: a test file that imports the helper gets
+// 120 s per test and 180 s per hook WITHOUT a line of its own. This file has none. It asks the
+// helper for nothing but the run (no clone), so it takes milliseconds.
+//
+// What a file that sets its own limits keeps: `limits-own.db.test.ts`. The rule itself and the
+// database-free project: `limits.test.ts`.
+import { afterAll, beforeAll, describe, expect, it } from 'vitest';
+import { DB_HOOK_TIMEOUT_MS, DB_TEST_TIMEOUT_MS } from '../constants';
+import { currentTestLimits, isNoLimit, providedRun } from '../index';
+
+/**
+ * At least the cap, or no limit at all: a run that was started without limits (`--test-timeout=0`,
+ * under a debugger) keeps none, and that is not below any cap.
+ */
+function atLeast(limit: number | undefined, cap: number): boolean {
+  return limit !== undefined && (isNoLimit(limit) || limit >= cap);
+}
+
+/** Read while the file is collected: after its imports, before its first hook or test is registered. */
+const atCollection = currentTestLimits();
+let inBeforeAll: ReturnType<typeof currentTestLimits> = null;
+let inAfterAll: ReturnType<typeof currentTestLimits> = null;
+
+beforeAll(() => {
+  inBeforeAll = currentTestLimits();
+});
+
+afterAll(() => {
+  inAfterAll = currentTestLimits();
+  // An assertion in the last hook: a failure here fails the file.
+  expect(atLeast(inAfterAll?.hookTimeout, DB_HOOK_TIMEOUT_MS)).toBe(true);
+});
+
+describe('a database test file with no limit of its own', () => {
+  it('runs in a run of the database tests', () => {
+    expect(providedRun().prefix).toMatch(/^dems_test_/);
+  });
+
+  it('has the two limits raised before its first hook or test is registered', () => {
+    expect(atCollection).not.toBeNull();
+    expect(atLeast(atCollection?.testTimeout, DB_TEST_TIMEOUT_MS), String(atCollection?.testTimeout)).toBe(true);
+    expect(atLeast(atCollection?.hookTimeout, DB_HOOK_TIMEOUT_MS), String(atCollection?.hookTimeout)).toBe(true);
+  });
+
+  it('a test of it has 120 s, by what the runner itself says of the test', ({ task }) => {
+    expect(atLeast(task.timeout, DB_TEST_TIMEOUT_MS), String(task.timeout)).toBe(true);
+    expect(task.timeout).toBe(atCollection?.testTimeout);
+  });
+
+  it('a hook of it has 180 s', () => {
+    expect(atLeast(inBeforeAll?.hookTimeout, DB_HOOK_TIMEOUT_MS), String(inBeforeAll?.hookTimeout)).toBe(true);
+    expect(inBeforeAll).toEqual(atCollection);
+  });
+
+  it('a limit on one test is that test\'s own, lower or higher', ({ task }) => {
+    expect(task.timeout).toBe(7_000);
+  }, 7_000);
+
+  it('the limits are never BELOW the caps, and never a number the runner would misread', ({ task }) => {
+    // With the project as it is configured (the runner's own 5 s and 10 s) they are the caps
+    // exactly; `limits.test.ts` pins that. Here: whatever the run was started with, a database
+    // test is not stopped earlier than at the cap.
+    const now = currentTestLimits();
+    expect(now).not.toBeNull();
+    expect(Number.isNaN(task.timeout)).toBe(false);
+    expect(isNoLimit(task.timeout) || task.timeout >= DB_TEST_TIMEOUT_MS).toBe(true);
+    expect(atLeast(now?.hookTimeout, DB_HOOK_TIMEOUT_MS)).toBe(true);
+  });
+});
diff --git b/apps/core-server/test/helpers/db/__tests__/limits.test.ts b/apps/core-server/test/helpers/db/__tests__/limits.test.ts
new file mode 100644
index 0000000..5924dc0
--- /dev/null
+++ b/apps/core-server/test/helpers/db/__tests__/limits.test.ts
@@ -0,0 +1,120 @@
+// Decision D114: the helper raises the runner's two limits for a database test file, by itself.
+// This file belongs to the database-free project, where no run is provided, and proves:
+//
+//   - the rule: a limit below its cap is raised to the cap; a limit at or above it is kept, and
+//     so is "no limit" (zero, to the runner);
+//   - the helper can read the limits the runner holds, in this version of the runner;
+//   - a file of the database-free project that imports the helper keeps the runner's limits.
+//
+// Against a run of the database tests: `limits.db.test.ts` (a file with no limit of its own)
+// and `limits-own.db.test.ts` (a file that sets its own).
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { DB_HOOK_TIMEOUT_MS, DB_TEST_TIMEOUT_MS, PROVIDE_KEY } from '../constants';
+import { currentTestLimits, isNoLimit, raisedTestLimits } from '../index';
+
+afterEach(() => {
+  vi.resetConfig();
+});
+
+describe('the two caps', () => {
+  it('are 120 s per test and 180 s per hook', () => {
+    expect([DB_TEST_TIMEOUT_MS, DB_HOOK_TIMEOUT_MS]).toEqual([120_000, 180_000]);
+  });
+});
+
+describe('a limit is only ever raised', () => {
+  it("the runner's own limits, 5 s and 10 s, become the caps", () => {
+    expect(raisedTestLimits({ testTimeout: 5_000, hookTimeout: 10_000 })).toEqual({ testTimeout: 120_000, hookTimeout: 180_000 });
+  });
+
+  it('a limit that is already higher is kept, each of the two by itself', () => {
+    expect(raisedTestLimits({ testTimeout: 300_000, hookTimeout: 400_000 })).toEqual({ testTimeout: 300_000, hookTimeout: 400_000 });
+    expect(raisedTestLimits({ testTimeout: 300_000, hookTimeout: 10_000 })).toEqual({ testTimeout: 300_000, hookTimeout: 180_000 });
+    expect(raisedTestLimits({ testTimeout: 5_000, hookTimeout: 400_000 })).toEqual({ testTimeout: 120_000, hookTimeout: 400_000 });
+  });
+
+  it('a limit exactly at its cap is kept', () => {
+    expect(raisedTestLimits({ testTimeout: 120_000, hookTimeout: 180_000 })).toEqual({ testTimeout: 120_000, hookTimeout: 180_000 });
+  });
+
+  it('"no limit" is kept: to the runner zero, a negative number and infinity mean "never stop this test"', () => {
+    // A run under a debugger is started with `--test-timeout=0`: the helper must not end it after 120 s.
+    expect(raisedTestLimits({ testTimeout: 0, hookTimeout: 0 })).toEqual({ testTimeout: 0, hookTimeout: 0 });
+    expect(raisedTestLimits({ testTimeout: -1, hookTimeout: -1 })).toEqual({ testTimeout: -1, hookTimeout: -1 });
+    expect(raisedTestLimits({ testTimeout: Number.POSITIVE_INFINITY, hookTimeout: Number.POSITIVE_INFINITY })).toEqual({
+      testTimeout: Number.POSITIVE_INFINITY,
+      hookTimeout: Number.POSITIVE_INFINITY,
+    });
+    // Each of the two by itself.
+    expect(raisedTestLimits({ testTimeout: 0, hookTimeout: 10_000 })).toEqual({ testTimeout: 0, hookTimeout: 180_000 });
+    expect(raisedTestLimits({ testTimeout: 5_000, hookTimeout: 0 })).toEqual({ testTimeout: 120_000, hookTimeout: 0 });
+    expect([0, -1, Number.POSITIVE_INFINITY].every(isNoLimit)).toBe(true);
+    expect([1, 5_000, 120_000, Number.MAX_SAFE_INTEGER].some(isNoLimit)).toBe(false);
+  });
+
+  it('a value that is no number of milliseconds is replaced by the cap', () => {
+    expect(raisedTestLimits({ testTimeout: Number.NaN, hookTimeout: Number.NaN })).toEqual({ testTimeout: 120_000, hookTimeout: 180_000 });
+  });
+
+  it('where the limits cannot be read, the caps are what is set', () => {
+    expect(raisedTestLimits(null)).toEqual({ testTimeout: 120_000, hookTimeout: 180_000 });
+  });
+
+  it.each([
+    [1, 1],
+    [4_999, 9_999],
+    [60_000, 120_000],
+    [119_999, 179_999],
+    [120_001, 180_001],
+    [3_600_000, 3_600_000],
+  ])('never lowers: %i and %i', (testTimeout, hookTimeout) => {
