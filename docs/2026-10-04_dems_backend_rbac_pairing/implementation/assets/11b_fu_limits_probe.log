# W11b follow-up: does the line vi.setConfig({ testTimeout: 120_000, hookTimeout: 180_000 }) take effect in Vitest 5.0.3, for a test, for a hook, and when the tests are defined by an imported module (as in the two isolation files)?
# Four probe files in the scratch copy OUTSIDE the repository, removed afterwards. Expected: the file with the line passes; the two controls without it fail at 5 s and at 10 s. 2026-10-04 18:16:37 WIB
--- zz-cap-suite.ts
// SCRATCH ONLY (never copied into the repository): a suite defined by an imported module, as the
// two isolation files do it.
import { beforeAll, expect, it } from 'vitest';

export const sleep = (ms: number): Promise<void> => new Promise((resolve) => setTimeout(resolve, ms));

export function defineSlowSuite(label: string): void {
  beforeAll(async () => {
    await sleep(10_500); // the runner's default for a hook is 10 s
  });
  it(`${label}: a test that takes 5.5 s`, async () => {
    await sleep(5_500); // the runner's default for a test is 5 s
    expect(true).toBe(true);
  });
}
--- zz-cap-probe.test.ts
// SCRATCH ONLY: with the line, a 5.5 s test and a 10.5 s hook pass.
import { vi } from 'vitest';
import { defineSlowSuite } from './zz-cap-suite';

vi.setConfig({ testTimeout: 120_000, hookTimeout: 180_000 });

defineSlowSuite('with the limits');
--- zz-cap-control-test.test.ts
// SCRATCH ONLY: without the line, a 5.5 s test fails at 5 s.
import { expect, it } from 'vitest';
import { sleep } from './zz-cap-suite';

it('control: a test that takes 5.5 s', async () => {
  await sleep(5_500);
  expect(true).toBe(true);
});
--- zz-cap-control-hook.test.ts
// SCRATCH ONLY: without the line, a 10.5 s hook fails at 10 s.
import { defineSlowSuite } from './zz-cap-suite';

defineSlowSuite('control, no limits');
