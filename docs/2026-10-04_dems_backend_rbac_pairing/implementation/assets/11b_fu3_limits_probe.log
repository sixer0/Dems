## 5. The helper only RAISES, whatever the run was started with: the same two files (outside the tree, no limit line) under four command lines. 2026-10-04 20:55:18 WIB
# To the runner a limit of zero is NO limit (Vitest 5.0.3, run.js: 'if (timeout <= 0 || timeout === Number.POSITIVE_INFINITY) return fn'): it must stay zero.
# (Measured beside it: this runner does not hand --hookTimeout to the project; the control holds 10000 for a hook whatever the flag says. Not the helper's doing.)
--- zz-zero.db.test.ts
// SCRATCH ONLY: print what the runner holds, in a file that uses the helper (no limit line).
import { beforeAll, expect, it } from 'vitest';
import { currentTestLimits, providedRun } from '../index';

const atCollection = currentTestLimits();
let inHook: ReturnType<typeof currentTestLimits> = null;
beforeAll(() => {
  inHook = currentTestLimits();
});

it('prints the limits', ({ task }) => {
  expect(providedRun().prefix).toMatch(/^dems_test_/);
  console.log(`[with the helper]    at collection ${JSON.stringify(atCollection)}; in a hook ${JSON.stringify(inHook)}; the limit of this test (task.timeout) ${String(task.timeout)}`);
});
--- zz-zero-control.db.test.ts
// SCRATCH ONLY: the same in a file that does NOT use the helper (the reader is copied here).
import { expect, it } from 'vitest';

it('prints the limits', ({ task }) => {
  const state = (globalThis as { __vitest_worker__?: { config?: { testTimeout?: unknown; hookTimeout?: unknown } } }).__vitest_worker__;
  console.log(`[without the helper] the runner holds ${JSON.stringify({ testTimeout: state?.config?.testTimeout, hookTimeout: state?.config?.hookTimeout })}; the limit of this test (task.timeout) ${String(task.timeout)}`);
  expect(true).toBe(true);
});
