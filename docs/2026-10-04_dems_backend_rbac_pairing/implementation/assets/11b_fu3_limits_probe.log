--- zz-probe-helper.db.test.ts
// SCRATCH ONLY. NO limit line of its own. It uses the helper (useTestDatabase).
// Its own hook waits 10.5 s (the runner's limit for a hook is 10 s); its test waits 5.5 s inside
// the body (the runner's limit for a test is 5 s).
import { beforeAll, expect, it } from 'vitest';
import { useTestDatabase } from '../index';
import { SELFTEST_TEMPLATE } from '../testing/probe-hooks';

const sleep = (ms: number): Promise<void> => new Promise((resolve) => setTimeout(resolve, ms));
const db = useTestDatabase({ template: SELFTEST_TEMPLATE });

beforeAll(async () => {
  await sleep(10_500);
});

it('uses the helper: a test that waits 5.5 s inside its body', async () => {
  await db.ownerPool().query('SELECT 1');
  await sleep(5_500);
  expect(db.name).toMatch(/^dems_test_/);
});
--- zz-probe-with-only.db.test.ts
// SCRATCH ONLY. NO limit line of its own. It uses the helper through withTestDatabase alone,
// which is called INSIDE the test: the limit must have been raised before the test was registered.
import { expect, it } from 'vitest';
import { withTestDatabase } from '../index';
import { SELFTEST_TEMPLATE } from '../testing/probe-hooks';

const sleep = (ms: number): Promise<void> => new Promise((resolve) => setTimeout(resolve, ms));

it('uses withTestDatabase only: a test that waits 5.5 s inside its body', async () => {
  const name = await withTestDatabase({ template: SELFTEST_TEMPLATE, slug: 'probe' }, async (database) => {
    await sleep(5_500);
    return database.name;
  });
  expect(name).toMatch(/^dems_test_/);
});
