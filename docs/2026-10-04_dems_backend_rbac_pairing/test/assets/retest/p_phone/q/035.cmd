w1 js (async()=>{const r=await fetch('/api/v1/audit?sessionId=SES-20261006-0035&limit=200',{credentials:'same-origin'});const d=await r.json();const keep=['SESSION_CREATED','PRECHECK_PASSED','RECORDING_STARTED','RECORDING_STOPPED','EVIDENCE_SEALED','SUMMARY_ACKNOWLEDGED'];return {total:d.total,rows:d.rows.filter(x=>keep.includes(x.type)).map(x=>[x.seq,x.type,x.actorId,new Date(x.at).toISOString(),JSON.stringify(x.details).slice(0,140)])}})()
w1 js (async()=>{const r=await fetch('/api/v1/evidence/EV-20261006-0023',{credentials:'same-origin'});const d=await r.json();const e=d.evidence;return {id:e.id,sessionId:e.sessionId,status:e.status,durationMs:e.durationMs,sizeBytes:e.sizeBytes,sealedAt:new Date(e.sealedAt).toISOString(),custody:e.custody.map(c=>[c.action,c.actorId,new Date(c.at).toISOString(),c.detail]),manifest:e.manifestHash.slice(0,16)}})()
w1 js (async()=>{const r=await fetch('/api/v1/admin/users',{credentials:'same-origin'});const d=await r.json();return d.users.map(u=>[u.id,u.displayName,u.role])})()
