# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# ---------------------------------------------------------------------------
# DEMS demo stack (blueprint row 7)
# ---------------------------------------------------------------------------

# Confidential design book - never version it
*.docx

# Dependencies
node_modules/

# Build outputs
dist/
build/
web-build/
*.tsbuildinfo

# Expo
.expo/
.expo-shared/

# Native folders generated by `expo prebuild` (regenerable)
apps/mobile/android/
apps/mobile/ios/

