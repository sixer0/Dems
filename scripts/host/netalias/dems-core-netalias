#!/usr/bin/python3 -ISB
# DEMS Core address helper: adds and removes ONE temporary private /24 address on the camera
# port, so that a factory-new camera on another subnet can be reached during commissioning.
#
# THIS FILE IS INSTALLED BY THE USER, AS ROOT, AFTER ITS SECURITY REVIEW. No agent and no script
# of this repository installs it, runs it with privilege or lets it change a host address.
# The steps, the hashes to compare and the proofs of refusal are in the helper installation
# chapter of the hardware acceptance package; the installed state is items HOST-43 to HOST-47 of
# scripts/host/HOST-PROFILE-UBUNTU-24.04.md.
#
# Form (decision C19): a root service on a local socket. The service manager starts one instance
# of this file per connection, as root, with the connection as standard input and output and
# standard error to the journal (dems-core-netalias.socket, dems-core-netalias@.service).
# The Core's service user never starts this file and never passes it an argument.
#
#   request  one line, at most 64 bytes, printable ASCII, single spaces, ended by a line feed:
#              add <a.b.c.d>/24 <minutes>      minutes 5 to 480
#              del <a.b.c.d>/24
#   answer   one line "<code> <NAME>", the same code is the exit status. Closed set, see CODES.
#   journal  one line per call on standard error: calling user, verb, address, result.
#            The address is printed only after it passed every check of its form; no other text
#            of the caller is ever printed, in the answer or in the journal.
#
# The helper is the enforcement boundary (security item S13-08): it trusts no caller. It
#   1. takes the verb and one address; reads the interface from a root-owned file, checks the
#      name against a pattern and against the kernel's interface list, refuses the interface of
#      the default route;
#   2. accepts an RFC 1918 address with /24 only, host part 1 to 254;
#   3. refuses "add" when another interface holds an address in that /24, and when its own limit
#      of marked addresses is reached;
#   4. always runs the conflict check and refuses when its tool is missing, when the file at the
#      tool's path is not the one the package manager recorded for the package iputils-arping,
#      when the camera port cannot be asked (loopback, no-ARP, no broadcast, down, no carrier, or
#      a state it cannot read), and whenever the tool's printed result and its exit status do not
#      together say "asked, nobody answered". An exit status alone is never read as "free";
#   5. marks what it adds (a root-owned file under /run) and gives the address a kernel lifetime
#      of 5 to 480 minutes;
#   6. removes only an address it marked: the mark must be younger than the lifetime it records
#      and the kernel must still show the address with a lifetime no longer than that. Every
#      "add", and every "del" of a marked address, first drops each mark that no longer stands
#      for such an address, whichever way the address went;
#   7. calls its tools by absolute path with a fixed search path and a fixed, two-entry
#      environment, reads nothing from its own environment, evaluates no input, starts no shell;
#   8. writes one journal line per call;
#   9. answers with fixed codes and fixed words.
#
# The one command-line form is "check", for root during installation: it reads the same files
# and the route table, changes nothing, and is not reachable through the socket, because the
# service unit starts this file without arguments.
#
# Python 3 standard library only (Ubuntu 24.04 ships /usr/bin/python3; no package is added).

import errno
import hashlib
import json
import os
import re
import select
import socket
import stat
import struct
import subprocess
import sys
import time

# --- CONSTANTS (begin) -----------------------------------------------------------------------
# Every path and number below is a constant of this file. Nothing here is read from the
# environment, from an argument or from the request. The test copy is made by the build step
# make_test_copy.py, which replaces the values of this block and nothing else; the file handed to
# the user is this one, and its hash is in SHA256SUMS.
IP_TOOL = "/usr/sbin/ip"
ARPING_TOOL = "/usr/bin/arping"
INTERFACE_FILE = "/etc/dems/netalias-interface"
SYSFS_NET = "/sys/class/net"
MARKS_DIR = "/run/dems-core-netalias/marks"
DPKG_INFO_DIR = "/var/lib/dpkg/info"
GROUP_FILE = "/etc/group"
PASSWD_FILE = "/etc/passwd"
TRUSTED_OWNER_UID = 0
PEER_OPTION_LEVEL = 1
PEER_OPTION_NAME = 17
PEER_STRUCT = "3i"
# --- CONSTANTS (end) -------------------------------------------------------------------------

# The dedicated group of the socket. Its ONLY member is the Core's service user (HOST-43); that
# member is the one caller this helper serves.
SERVICE_GROUP = "dems-netalias"

TOOL_ENV = (("PATH", "/usr/sbin:/usr/bin:/sbin:/bin"), ("LC_ALL", "C"))
TOOL_TIMEOUT_S = 5
CONFLICT_PROBES = 2
CONFLICT_WAIT_S = 3
CONFLICT_TIMEOUT_S = 8
# The ONE conflict-check program: the `arping` of the Ubuntu package iputils-arping, at ARPING_TOOL.
# The other package named `arping` ships another program with other options and other exit codes.
# The file at ARPING_TOOL is never started unless it is byte for byte the file the package
# manager recorded for this package (its file list and its checksum list, read as text).
CONFLICT_PACKAGE = "iputils-arping"
CONFLICT_TOOL_MAX_BYTES = 4 << 20
CONFLICT_OUTPUT_MAX_BYTES = 4096
# A mark is honoured this long past the lifetime it records: the kernel removes an expired
# address a moment after its lifetime, not at the same instant.
MARK_GRACE_S = 60
LIFETIME_FOREVER = 0xFFFFFFFF
REQUEST_MAX_BYTES = 64
REQUEST_TIMEOUT_S = 5
MINUTES_MIN = 5
MINUTES_MAX = 480
# One temporary address at a time. Security item S13-08 (3) allows two; the Core's own table
# allows one, and one is the narrower bound.
MAX_MARKED = 1
JOURNAL_TAG = "dems-core-netalias"

CODES = {
    "OK": 0,
    # the call itself
    "ARGUMENTS": 10,
    "PEER_UNKNOWN": 11,
    "PEER_NOT_SERVICE_USER": 12,
    "REQUEST_TOO_LONG": 13,
    "REQUEST_MALFORMED": 14,
    "VERB_UNKNOWN": 15,
    "REQUEST_TIMEOUT": 16,
    # the address
    "ADDRESS_MALFORMED": 20,
    "PREFIX_NOT_24": 21,
    "ADDRESS_LOOPBACK": 22,
    "ADDRESS_LINK_LOCAL": 23,
    "ADDRESS_MULTICAST": 24,
    "ADDRESS_NOT_PRIVATE": 25,
    "HOST_PART_OUT_OF_RANGE": 26,
    "LIFETIME_OUT_OF_RANGE": 27,
    # the installation
    "SERVICE_USER_UNRESOLVED": 30,
    "INTERFACE_FILE_UNSAFE": 31,
    "INTERFACE_NAME_INVALID": 32,
    "INTERFACE_ABSENT": 33,
    "INTERFACE_HAS_DEFAULT_ROUTE": 34,
    "STATE_DIR_UNSAFE": 35,
    "TOOL_MISSING": 36,
    "CONFLICT_TOOL_MISSING": 37,
    "CONFLICT_TOOL_NOT_EXPECTED": 38,
    # the host's state
    "OTHER_INTERFACE_HOLDS_SUBNET": 40,
    "ALIAS_LIMIT_REACHED": 41,
    "ADDRESS_ALREADY_PRESENT": 42,
    "CAMERA_INTERFACE_HOLDS_SUBNET": 43,
    "ADDRESS_IN_USE": 44,
    "NOT_MARKED": 45,
    "INTERFACE_NOT_ARPABLE": 46,
    "INTERFACE_DOWN": 47,
    "INTERFACE_STATE_UNKNOWN": 48,
    # a tool did not do its work
    "HOST_STATE_UNREADABLE": 50,
    "CONFLICT_CHECK_FAILED": 51,
    "ADD_FAILED": 52,
    "DEL_FAILED": 53,
    "MARK_WRITE_FAILED": 54,
    "CONFLICT_RESULT_UNKNOWN": 55,
    "INTERNAL": 60,
}

INTERFACE_NAME = re.compile(r"\A[A-Za-z0-9][A-Za-z0-9_.-]{0,14}\Z")
ACCOUNT_NAME = re.compile(r"\A[a-z_][a-z0-9_-]{0,31}\Z")
ADDRESS_TOKEN = re.compile(r"\A([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})/([0-9]{1,2})\Z")
QUAD = re.compile(r"\A([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\Z")
MINUTES_TOKEN = re.compile(r"\A[1-9][0-9]{0,2}\Z")
# What write_mark writes: the address, the interface, the second of the host's monotonic clock
# at which the mark was written, the minutes asked.
MARK_LINE = re.compile(r"\A([0-9.]{7,15})/24 ([A-Za-z0-9][A-Za-z0-9_.-]{0,14}) ([0-9]{1,12}) ([1-9][0-9]{0,2})\n\Z")
LINK_FLAG = re.compile(r"\A[A-Z0-9_-]{1,24}\Z")
CHECKSUM = re.compile(r"\A[0-9a-f]{32}\Z")
# The three lines the conflict-check program prints in the C locale when it has asked. The first
# names the address and the interface, the other two say how often it asked and what came back.
CONFLICT_HEAD = r"\AARPING %s from [0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3} %s\Z"
CONFLICT_SENT = re.compile(r"\ASent ([0-9]{1,4}) (?:probes|probe\(s\)|probe) \(([0-9]{1,4}) broadcast\(s\)\)\Z")
CONFLICT_RECEIVED = re.compile(r"\AReceived ([0-9]{1,4}) response\(s\)( \([0-9a-z(), ]{1,60}\))?\Z")


class Refusal(Exception):
    """A named refusal. It carries a name of CODES and nothing else."""

    def __init__(self, name):
        Exception.__init__(self, name)
        self.name = name


class Call:
    """What the journal line may say about this call. Only checked values are stored here."""

    def __init__(self):
        self.caller = "-"
        self.verb = "-"
        self.address = "-"
        self.note = ""


# --- Files this helper relies on ---


def _not_writable_by_others(st):
    return st.st_uid == TRUSTED_OWNER_UID and (st.st_mode & 0o022) == 0


def _safe_regular_file(path):
    """A regular file, not a symbolic link, owned by the trusted owner, not writable by group or others."""
    try:
        st = os.lstat(path)
    except OSError:
        return False
    return stat.S_ISREG(st.st_mode) and _not_writable_by_others(st)


def _safe_directory(path):
    try:
        st = os.lstat(path)
    except OSError:
        return False
    return stat.S_ISDIR(st.st_mode) and _not_writable_by_others(st)


def _safe_tool(path):
    """The tool as the kernel will execute it: a regular file of the trusted owner, executable."""
    try:
        st = os.stat(path)
    except OSError:
        return False
    return stat.S_ISREG(st.st_mode) and _not_writable_by_others(st) and (st.st_mode & 0o100) != 0


def _read_small(path, limit):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        data = os.read(fd, limit + 1)
    finally:
        os.close(fd)
    if len(data) > limit:
        raise ValueError("too large")
    return data


def _read_program(path, limit):
    """The bytes of a program file as the kernel will execute it (a link is followed, as by _safe_tool)."""
    fd = os.open(path, os.O_RDONLY)
    try:
        data = b""
        while len(data) <= limit:
            chunk = os.read(fd, 1 << 16)
            if chunk == b"":
                return data
            data += chunk
    finally:
        os.close(fd)
    raise ValueError("too large")


def _expected_conflict_tool():
    """True when the file at ARPING_TOOL is the one the package manager recorded for CONFLICT_PACKAGE.

    Nothing is started to learn this. Two root-owned text files of the package manager are read:
    the package's file list must name ARPING_TOOL, and its checksum list must hold exactly one
    checksum for that path, equal to the checksum of the file that is there now. A file of the
    other `arping` package, a file changed after installation, a missing or unsafe record: False.
    """
    listing = os.path.join(DPKG_INFO_DIR, CONFLICT_PACKAGE + ".list")
    checksums = os.path.join(DPKG_INFO_DIR, CONFLICT_PACKAGE + ".md5sums")
    try:
        if not (_safe_directory(DPKG_INFO_DIR) and _safe_regular_file(listing) and _safe_regular_file(checksums)):
            return False
        if ARPING_TOOL not in _read_small(listing, 1 << 16).decode("ascii").split("\n"):
            return False
        wanted = "  " + ARPING_TOOL[1:]
        recorded = [line[:32] for line in _read_small(checksums, 1 << 16).decode("ascii").split("\n") if line[32:] == wanted]
        if len(recorded) != 1 or CHECKSUM.match(recorded[0]) is None:
            return False
        # Not a secret and not a defence against root: the package manager's own record format.
        found = hashlib.md5(_read_program(ARPING_TOOL, CONFLICT_TOOL_MAX_BYTES), usedforsecurity=False).hexdigest()
        return found == recorded[0]
    except (OSError, ValueError, UnicodeError):
        return False


def service_user_id():
    """The user id of the ONE member of the dedicated group, from the local account files."""
    try:
        if not (_safe_regular_file(GROUP_FILE) and _safe_regular_file(PASSWD_FILE)):
            raise ValueError("unsafe")
        members = None
        for line in _read_small(GROUP_FILE, 1 << 20).decode("ascii").split("\n"):
            fields = line.split(":")
            if len(fields) == 4 and fields[0] == SERVICE_GROUP:
                if members is not None:
                    raise ValueError("group twice")
                members = [name for name in fields[3].split(",") if name != ""]
        if members is None or len(members) != 1 or ACCOUNT_NAME.match(members[0]) is None:
            raise ValueError("not one member")
        found = None
        for line in _read_small(PASSWD_FILE, 1 << 20).decode("ascii").split("\n"):
            fields = line.split(":")
            if len(fields) == 7 and fields[0] == members[0]:
                if found is not None or re.match(r"\A[0-9]{1,10}\Z", fields[2]) is None:
                    raise ValueError("account twice or bad id")
                found = int(fields[2])
        if found is None or found == 0:
            raise ValueError("no account, or root")
        return found
    except (OSError, ValueError, UnicodeError):
        raise Refusal("SERVICE_USER_UNRESOLVED") from None


def configured_interface():
    """The camera interface: the one line of the root-owned file, checked, present in the kernel."""
    if not (_safe_directory(os.path.dirname(INTERFACE_FILE)) and _safe_regular_file(INTERFACE_FILE)):
        raise Refusal("INTERFACE_FILE_UNSAFE")
    try:
        raw = _read_small(INTERFACE_FILE, 64)
    except (OSError, ValueError):
        raise Refusal("INTERFACE_FILE_UNSAFE") from None
    text = raw.decode("latin-1")
    if text.endswith("\n"):
        text = text[:-1]
    if INTERFACE_NAME.match(text) is None:
        raise Refusal("INTERFACE_NAME_INVALID")
    if not os.path.lexists(os.path.join(SYSFS_NET, text)):
        raise Refusal("INTERFACE_ABSENT")
    return text


# --- The caller ---


def peer_user_id():
    """The user id the kernel recorded for the other end of standard input, a local stream socket."""
    try:
        duplicate = os.dup(0)
        try:
            peer = socket.socket(fileno=duplicate)
        except OSError:
            os.close(duplicate)
            raise
        try:
            if peer.family != socket.AF_UNIX or peer.type != socket.SOCK_STREAM:
                raise OSError(errno.ENOTSOCK, "not a local stream socket")
            raw = peer.getsockopt(PEER_OPTION_LEVEL, PEER_OPTION_NAME, struct.calcsize(PEER_STRUCT))
        finally:
            peer.close()
        if len(raw) != struct.calcsize(PEER_STRUCT):
            raise OSError(errno.EINVAL, "short credentials")
        user = struct.unpack(PEER_STRUCT, raw)[1]
    except (OSError, ValueError, struct.error):
        raise Refusal("PEER_UNKNOWN") from None
    if not isinstance(user, int) or user < 0 or user >= 0xFFFFFFFF:
        raise Refusal("PEER_UNKNOWN")
    return user


# --- The request ---


def read_request_line():
    """One line of at most REQUEST_MAX_BYTES bytes from standard input, and nothing after it."""
    deadline = time.monotonic() + REQUEST_TIMEOUT_S
    data = b""
    while b"\n" not in data:
        if len(data) > REQUEST_MAX_BYTES:
            raise Refusal("REQUEST_TOO_LONG")
        remaining = deadline - time.monotonic()
        if remaining <= 0 or not select.select([0], [], [], remaining)[0]:
            raise Refusal("REQUEST_TIMEOUT")
        chunk = os.read(0, REQUEST_MAX_BYTES + 1 - len(data))
        if chunk == b"":
            raise Refusal("REQUEST_MALFORMED")
        data += chunk
    end = data.index(b"\n")
    if end + 1 > REQUEST_MAX_BYTES:
        raise Refusal("REQUEST_TOO_LONG")
    if end + 1 != len(data):
        raise Refusal("REQUEST_MALFORMED")
    if select.select([0], [], [], 0)[0] and os.read(0, 1) != b"":
        raise Refusal("REQUEST_MALFORMED")
    return data[:end]


def parse_quad(text):
    """Four decimal parts 0 to 255 without a leading zero, or None."""
    match = QUAD.match(text)
    if match is None:
        return None
    parts = []
    for part in match.groups():
        if len(part) > 1 and part[0] == "0":
            return None
        number = int(part)
        if number > 255:
            return None
        parts.append(number)
    return tuple(parts)


def checked_address(token):
    """The address of the request as four numbers. Refuses everything but a private /24 host address."""
    match = ADDRESS_TOKEN.match(token)
    if match is None:
        raise Refusal("ADDRESS_MALFORMED")
    quad = parse_quad(token.split("/")[0])
    if quad is None:
        raise Refusal("ADDRESS_MALFORMED")
    if match.group(5) != "24":
        raise Refusal("PREFIX_NOT_24")
    a, b, _, d = quad
    if a == 127:
        raise Refusal("ADDRESS_LOOPBACK")
    if a == 169 and b == 254:
        raise Refusal("ADDRESS_LINK_LOCAL")
    if 224 <= a <= 239:
        raise Refusal("ADDRESS_MULTICAST")
    if not (a == 10 or (a == 172 and 16 <= b <= 31) or (a == 192 and b == 168)):
        raise Refusal("ADDRESS_NOT_PRIVATE")
    if d < 1 or d > 254:
        raise Refusal("HOST_PART_OUT_OF_RANGE")
    return quad


def parse_request(line, call):
    """(verb, address as four numbers, minutes or None). Fills `call` only with checked values."""
    for byte in line:
        if byte < 0x20 or byte > 0x7E:
            raise Refusal("REQUEST_MALFORMED")
    tokens = line.decode("ascii").split(" ")
    if "" in tokens:
        raise Refusal("REQUEST_MALFORMED")
    if tokens[0] not in ("add", "del"):
        raise Refusal("VERB_UNKNOWN")
    verb = tokens[0]
    call.verb = verb
    if len(tokens) != (3 if verb == "add" else 2):
        raise Refusal("REQUEST_MALFORMED")
    quad = checked_address(tokens[1])
    minutes = None
    if verb == "add":
        if MINUTES_TOKEN.match(tokens[2]) is None or not MINUTES_MIN <= int(tokens[2]) <= MINUTES_MAX:
            raise Refusal("LIFETIME_OUT_OF_RANGE")
        minutes = int(tokens[2])
    call.address = dotted(quad) + "/24"
    return verb, quad, minutes


def dotted(quad):
    return "%d.%d.%d.%d" % quad


def as_number(quad):
    return (quad[0] << 24) | (quad[1] << 16) | (quad[2] << 8) | quad[3]


# --- The tools ---


def run_tool(vector, timeout):
    """Runs one tool by absolute path. Returns (exit status or None, standard output). No shell."""
    try:
        done = subprocess.run(
            vector,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            env=dict(TOOL_ENV),
            cwd="/",
            timeout=timeout,
            close_fds=True,
            shell=False,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return None, b""
    return done.returncode, done.stdout


def _json_list(vector):
    status, output = run_tool(vector, TOOL_TIMEOUT_S)
    if status != 0 or len(output) > (1 << 20):
        raise Refusal("HOST_STATE_UNREADABLE")
    try:
        value = json.loads(output.decode("utf-8"))
    except (ValueError, UnicodeError):
        raise Refusal("HOST_STATE_UNREADABLE") from None
    if not isinstance(value, list):
        raise Refusal("HOST_STATE_UNREADABLE")
    return value


def default_route_interfaces():
    names = set()
    for route in _json_list([IP_TOOL, "-json", "-4", "route", "show", "default"]):
        if not isinstance(route, dict):
            raise Refusal("HOST_STATE_UNREADABLE")
        hops = route.get("nexthops", [])
        if not isinstance(hops, list):
            raise Refusal("HOST_STATE_UNREADABLE")
        for entry in [route] + hops:
            if isinstance(entry, dict) and isinstance(entry.get("dev"), str):
                names.add(entry["dev"])
    return names


def host_state():
    """One read of the host: (addresses, link flags).

    addresses   every IPv4 address as (interface name, four numbers, prefix length, lifetime);
                the lifetime is the kernel's remaining valid lifetime in seconds, LIFETIME_FOREVER
                for an address without one, None when the listing does not state it.
    link flags  {interface name: the kernel's flag words}; None in the place of the words when
                they are not a list of flag words or the name is listed twice. An interface
                without an IPv4 address is not in this listing at all.
    """
    found = []
    flags = {}
    for link in _json_list([IP_TOOL, "-json", "-4", "addr", "show"]):
        if not isinstance(link, dict) or not isinstance(link.get("ifname"), str):
            raise Refusal("HOST_STATE_UNREADABLE")
        words = link.get("flags")
        readable = isinstance(words, list) and all(isinstance(word, str) and LINK_FLAG.match(word) for word in words)
        flags[link["ifname"]] = frozenset(words) if readable and link["ifname"] not in flags else None
        infos = link.get("addr_info", [])
        if not isinstance(infos, list):
            raise Refusal("HOST_STATE_UNREADABLE")
        for info in infos:
            if not isinstance(info, dict):
                raise Refusal("HOST_STATE_UNREADABLE")
            if info.get("family") != "inet":
                continue
            local = info.get("local")
            length = info.get("prefixlen")
            quad = parse_quad(local) if isinstance(local, str) else None
            if quad is None or isinstance(length, bool) or not isinstance(length, int) or not 0 <= length <= 32:
                raise Refusal("HOST_STATE_UNREADABLE")
            lifetime = info.get("valid_life_time")
            if isinstance(lifetime, bool) or not isinstance(lifetime, int) or not 0 <= lifetime <= LIFETIME_FOREVER:
                lifetime = None
            found.append((link["ifname"], quad, length, lifetime))
    return found, flags


def refuse_unless_askable(interface, flags):
    """What the conflict check can KNOW before it is started: only a port that can be asked is asked.

    The conflict-check program answers 0 without asking on a port that cannot carry the question.
    The kernel's own flag words decide: a loopback or no-ARP port, or one without a broadcast
    address, cannot be asked; a port that is not up or has no carrier reaches nobody. A port
    whose words cannot be read is not asked either.
    """
    words = flags.get(interface)
    if words is None:
        raise Refusal("INTERFACE_STATE_UNKNOWN")
    if "LOOPBACK" in words or "NOARP" in words or "BROADCAST" not in words:
        raise Refusal("INTERFACE_NOT_ARPABLE")
    if "UP" not in words or "LOWER_UP" not in words:
        raise Refusal("INTERFACE_DOWN")


def conflict_verdict(status, output, interface, quad):
    """"FREE", or the name of the refusal. The printed result and the exit status must agree.

    FREE              status 0, and the program's whole text is three lines: it asked for THIS
                      address on THIS interface, sent at least CONFLICT_PROBES probes, at least one
                      as a broadcast, and received 0 responses. Any further line is not this text.
    ADDRESS_IN_USE    status 1, the same first line and last two lines, at least one response
                      counted.
    Everything else, an exit status of 0 with no such statement among it, is not a result.
    """
    if status not in (0, 1):
        return "CONFLICT_CHECK_FAILED"
    try:
        if len(output) > CONFLICT_OUTPUT_MAX_BYTES:
            raise ValueError("too large")
        lines = output.decode("ascii").split("\n")
    except (ValueError, UnicodeError):
        return "CONFLICT_RESULT_UNKNOWN"
    # The first line, the last two, and the empty text after the last line end. Between them
    # stand the replies, one line each: a free address has none, so its text is three lines.
    if len(lines) < 4 or lines[-1] != "":
        return "CONFLICT_RESULT_UNKNOWN"
    head = re.match(CONFLICT_HEAD % (re.escape(dotted(quad)), re.escape(interface)), lines[0])
    asked = CONFLICT_SENT.match(lines[-3])
    answer = CONFLICT_RECEIVED.match(lines[-2])
    replies = lines[1:-3]
    if head is None or asked is None or answer is None or "" in replies:
        return "CONFLICT_RESULT_UNKNOWN"
    responses = int(answer.group(1))
    if status == 1 and responses >= 1:
        return "ADDRESS_IN_USE"
    if (status == 0 and responses == 0 and answer.group(2) is None and not replies
            and int(asked.group(1)) >= CONFLICT_PROBES and int(asked.group(2)) >= 1):
        return "FREE"
    return "CONFLICT_RESULT_UNKNOWN"


def overlaps_slash24(quad, other, other_length):
    """True when the network of `other` and the /24 of `quad` share an address."""
    length = min(other_length, 24)
    mask = (0xFFFFFFFF << (32 - length)) & 0xFFFFFFFF if length > 0 else 0
    return (as_number(quad) & mask) == (as_number(other) & mask)


# --- The marks: what this helper added ---


def marked_addresses():
    if not _safe_directory(MARKS_DIR):
        raise Refusal("STATE_DIR_UNSAFE")
    marks = set()
    try:
        names = os.listdir(MARKS_DIR)
    except OSError:
        raise Refusal("STATE_DIR_UNSAFE") from None
    for name in names:
        quad = parse_quad(name)
        if quad is None or dotted(quad) != name or not _safe_regular_file(os.path.join(MARKS_DIR, name)):
            raise Refusal("STATE_DIR_UNSAFE")
        marks.add(quad)
    return marks


def write_mark(quad, interface, minutes):
    # The clock is the host's monotonic one: it starts at boot, as the marks folder does, and a
    # change of the wall clock cannot make a mark younger or older than it is.
    try:
        fd = os.open(
            os.path.join(MARKS_DIR, dotted(quad)),
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            0o644,
        )
        try:
            os.write(fd, ("%s/24 %s %d %d\n" % (dotted(quad), interface, int(time.monotonic()), minutes)).encode("ascii"))
        finally:
            os.close(fd)
    except OSError:
        raise Refusal("MARK_WRITE_FAILED") from None


def drop_mark(quad):
    try:
        os.unlink(os.path.join(MARKS_DIR, dotted(quad)))
    except OSError:
        pass


def on_camera_interface(addresses, interface, quad):
    return any(name == interface and held == quad and length == 24 for name, held, length, _ in addresses)


def read_mark(quad):
    """(interface, second of the monotonic clock, minutes) of a mark, or None when it is not what write_mark writes."""
    try:
        match = MARK_LINE.match(_read_small(os.path.join(MARKS_DIR, dotted(quad)), 64).decode("ascii"))
    except (OSError, ValueError, UnicodeError):
        return None
    if match is None or match.group(1) != dotted(quad) or not MINUTES_MIN <= int(match.group(4)) <= MINUTES_MAX:
        return None
    return match.group(2), int(match.group(3)), int(match.group(4))


def mark_stands(quad, interface, addresses):
    """True when the mark of `quad` still stands for an address this helper added.

    It does when the mark was written for this interface, is not older than the lifetime it
    records (and not from before this boot's clock), and the kernel shows the address on the
    camera interface with a remaining lifetime no longer than the one that was asked. An address
    without a lifetime, or with a longer one, is somebody else's, whatever the mark says. When the
    address is there and the listing does not state its lifetime, nothing can be decided: refusal.
    """
    mark = read_mark(quad)
    if mark is None or mark[0] != interface:
        return False
    age = int(time.monotonic()) - mark[1]
    if age < 0 or age > mark[2] * 60 + MARK_GRACE_S:
        return False
    lifetimes = [lifetime for name, held, length, lifetime in addresses if name == interface and held == quad and length == 24]
    if None in lifetimes:
        raise Refusal("HOST_STATE_UNREADABLE")
    return len(lifetimes) == 1 and lifetimes[0] <= mark[2] * 60


def standing_marks(interface, addresses):
    """The marks that still stand. Every other mark is dropped here, whichever way its address went."""
    standing = set()
    for quad in marked_addresses():
        if mark_stands(quad, interface, addresses):
            standing.add(quad)
        else:
            drop_mark(quad)
    return standing


# --- The two verbs ---


def installation(need_conflict_tool):
    """The checks every call makes on what the user installed. Returns the camera interface."""
    interface = configured_interface()
    if not _safe_tool(IP_TOOL):
        raise Refusal("TOOL_MISSING")
    if need_conflict_tool:
        if not _safe_tool(ARPING_TOOL):
            raise Refusal("CONFLICT_TOOL_MISSING")
        if not _expected_conflict_tool():
            raise Refusal("CONFLICT_TOOL_NOT_EXPECTED")
    marked_addresses()
    if interface in default_route_interfaces():
        raise Refusal("INTERFACE_HAS_DEFAULT_ROUTE")
    return interface


def add(quad, minutes, call):
    interface = installation(need_conflict_tool=True)
    addresses, flags = host_state()
    # A mark whose address is gone (expired by the kernel, removed by hand), or whose address is
    # no longer the one this helper added, is dropped before anything is decided.
    marks = standing_marks(interface, addresses)
    if any(held == quad for _, held, _, _ in addresses):
        raise Refusal("ADDRESS_ALREADY_PRESENT")
    if any(name != interface and overlaps_slash24(quad, held, length) for name, held, length, _ in addresses):
        raise Refusal("OTHER_INTERFACE_HOLDS_SUBNET")
    if len(marks) >= MAX_MARKED:
        raise Refusal("ALIAS_LIMIT_REACHED")
    if any(name == interface and overlaps_slash24(quad, held, length) for name, held, length, _ in addresses):
        raise Refusal("CAMERA_INTERFACE_HOLDS_SUBNET")
    refuse_unless_askable(interface, flags)
    # The option set of the iputils program: duplicate address detection, a count, a deadline in
    # seconds, the interface. Not quiet: its printed result is read together with its exit status.
    status, output = run_tool(
        [ARPING_TOOL, "-D", "-c", str(CONFLICT_PROBES), "-w", str(CONFLICT_WAIT_S), "-I", interface, dotted(quad)],
        CONFLICT_TIMEOUT_S,
    )
    verdict = conflict_verdict(status, output, interface, quad)
    if verdict != "FREE":
        raise Refusal(verdict)
    seconds = str(minutes * 60)
    write_mark(quad, interface, minutes)
    status, _ = run_tool(
        [IP_TOOL, "addr", "add", dotted(quad) + "/24", "dev", interface, "valid_lft", seconds, "preferred_lft", seconds],
        TOOL_TIMEOUT_S,
    )
    if status != 0:
        # A tool that answered "no" added nothing. A tool that did not answer (time bound) may
        # have: the mark stays, so that "del" can still remove the address; the next "add"
        # drops the mark if the address is not there.
        if status is not None:
            drop_mark(quad)
        raise Refusal("ADD_FAILED")


def delete(quad, call):
    interface = installation(need_conflict_tool=False)
    if quad not in marked_addresses():
        raise Refusal("NOT_MARKED")
    addresses, _ = host_state()
    if quad not in standing_marks(interface, addresses):
        # The mark is dropped. An address that is there all the same is not the one this helper
        # added (its mark is past its lifetime, or the kernel shows a longer lifetime or none):
        # it is not removed. No address there: what was asked is already so.
        if on_camera_interface(addresses, interface, quad):
            raise Refusal("NOT_MARKED")
        call.note = "already-absent"
        return
    status, _ = run_tool([IP_TOOL, "addr", "del", dotted(quad) + "/24", "dev", interface], TOOL_TIMEOUT_S)
    if status != 0:
        raise Refusal("DEL_FAILED")
    drop_mark(quad)


def serve(arguments, call):
    if arguments == ["check"]:
        call.verb = "check"
        call.caller = str(os.getuid())
        service_user_id()
        installation(need_conflict_tool=True)
        return
    if arguments:
        raise Refusal("ARGUMENTS")
    expected = service_user_id()
    caller = peer_user_id()
    call.caller = str(caller)
    if caller != expected:
        raise Refusal("PEER_NOT_SERVICE_USER")
    verb, quad, minutes = parse_request(read_request_line(), call)
    if verb == "add":
        add(quad, minutes, call)
    else:
        delete(quad, call)


def main():
    os.umask(0o022)
    call = Call()
    try:
        serve(sys.argv[1:], call)
        result = "OK"
    except Refusal as refusal:
        result = refusal.name if refusal.name in CODES else "INTERNAL"
    except BaseException:
        result = "INTERNAL"
    code = CODES[result]
    note = " note=" + call.note if call.note else ""
    journal = "%s: caller_uid=%s verb=%s address=%s result=%s code=%d%s\n" % (
        JOURNAL_TAG, call.caller, call.verb, call.address, result, code, note)
    for descriptor, text in ((2, journal), (1, "%d %s\n" % (code, result))):
        try:
            os.write(descriptor, text.encode("ascii"))
        except OSError:
            pass
    os._exit(code)


main()
